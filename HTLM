  </main>

  <script>
    // Configuration de PDF.js (worker épinglé sur cdnjs)
    if (window.pdfjsLib) {
      pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
    }

    // État global de l'application
    const state = {
      mode: null,              // 'pdf' | 'img' | null
      baseName: 'tickets',     // Nom de base du fichier importé
      totalPages: 0,           // Nombre total de pages ou d'images
      currentPage: 0,          // Index 0-based de la page affichée
      pdfDoc: null,            // Instance PDFDocumentProxy (pdf.js)
      pdfBytes: null,          // ArrayBuffer du PDF source (pour pdf-lib)
      images: [],              // [{ img, width, height, scale, displayW, displayH }] en mode 'img'
      pageDimensions: [],      // [{ width, height }] en pixels du canvas d'affichage
      frames: [],              // Array de tableaux : [[{ x, y, w, h } | { quad: [[x,y],...] }, ...], ...]
      selectedIndex: -1,       // Index du ticket sélectionné sur la page courante
      pdfHighResCache: new Map() // Cache des rendus PDF à l'échelle 3 pour export image
    };

    const PDF_DISPLAY_SCALE = 1.5;
    const PDF_EXPORT_SCALE = 3.0;
    const MAX_IMG_DISPLAY_DIM = 2000;

    // Références DOM
    const dom = {
      dropView: document.getElementById('drop-view'),
      workspaceView: document.getElementById('workspace-view'),
      dropZone: document.getElementById('drop-zone'),
      fileInput: document.getElementById('file-input'),
      dropError: document.getElementById('drop-error'),
      btnResetFile: document.getElementById('btn-reset-file'),
      btnTheme: document.getElementById('btn-theme'),
      btnPrev: document.getElementById('btn-prev'),
      btnNext: document.getElementById('btn-next'),
      pageLabel: document.getElementById('page-label'),
      ticketCounter: document.getElementById('ticket-counter'),
      canvas: document.getElementById('page-canvas'),
      overlay: document.getElementById('overlay-layer'),
      quadSvg: document.getElementById('quad-svg'),
      btnAddFrame: document.getElementById('btn-add-frame'),
      btnAddQuad: document.getElementById('btn-add-quad'),
      btnDupFrame: document.getElementById('btn-dup-frame'),
      btnToQuad: document.getElementById('btn-to-quad'),
      btnClearPage: document.getElementById('btn-clear-page'),
      gapSlider: document.getElementById('gap-slider'),
      gapValue: document.getElementById('gap-value'),
      btnDetectPage: document.getElementById('btn-detect-page'),
      btnDetectAll: document.getElementById('btn-detect-all'),
      detectStatus: document.getElementById('detect-status'),
      sensSlider: document.getElementById('sens-slider'),
      sensValue: document.getElementById('sens-value'),
      btnDetectSkewPage: document.getElementById('btn-detect-skew-page'),
      btnDetectSkewAll: document.getElementById('btn-detect-skew-all'),
      skewStatus: document.getElementById('skew-status'),
      gridCols: document.getElementById('grid-cols'),
      gridRows: document.getElementById('grid-rows'),
      btnApplyGrid: document.getElementById('btn-apply-grid'),
      exportFormat: document.getElementById('export-format'),
      exportUpscale: document.getElementById('export-upscale'),
      chkEnhance: document.getElementById('chk-enhance'),
      btnExportZip: document.getElementById('btn-export-zip'),
      btnExportPdf: document.getElementById('btn-export-pdf'),
      exportProgressWrap: document.getElementById('export-progress-wrap'),
      exportProgressBar: document.getElementById('export-progress-bar'),
      exportStatus: document.getElementById('export-status')
    };

    // =========================================================================
    // BALANCE DES BLANCS : par ticket, non destructive (aperçu et export uniquement)
    // Chaque ticket porte son propre objet `wb` : { ref: [r, g, b], pt: [x, y], strength: 0..1 }
    // =========================================================================
    const wb = { mode: false, view: 'after', base: null, baseCtx: null, painted: false, raf: 0, undo: [], redo: [], dragBefore: null };
    const wbDom = {
      btn: document.getElementById('btn-wb'),
      status: document.getElementById('wb-status'),
      list: document.getElementById('wb-list'),
      strength: document.getElementById('wb-strength'),
      strengthValue: document.getElementById('wb-strength-value'),
      viewBefore: document.getElementById('wb-view-before'),
      viewAfter: document.getElementById('wb-view-after'),
      repick: document.getElementById('btn-wb-repick'),
      reset: document.getElementById('btn-wb-reset'),
      undo: document.getElementById('btn-wb-undo'),
      redo: document.getElementById('btn-wb-redo')
    };

    function cloneWb(w) { return w ? { ref: w.ref.slice(), pt: w.pt.slice(), strength: w.strength } : null; }
    function hasWb(item) { return !!(item && item.wb && item.wb.strength > 0.001); }
    function wbGains(ref) { return ref.map(v => Math.min(4, 255 / Math.max(v, 8))); }

    // Gain indépendant sur R, V et B (blanc de référence -> 255). Le noir reste noir (0 x gain = 0).
    // Les pixels franchement colorés après correction (logos, tampons) sont progressivement épargnés.
    function applyWbToImageData(d, w) {
      const s = w.strength;
      if (s <= 0) return;
      const g = wbGains(w.ref), g0 = g[0], g1 = g[1], g2 = g[2];
      for (let i = 0; i < d.length; i += 4) {
        const r = d[i], gg = d[i + 1], b = d[i + 2];
        let nr = r * g0, ng = gg * g1, nb = b * g2;
        if (nr > 255) nr = 255;
        if (ng > 255) ng = 255;
        if (nb > 255) nb = 255;
        const ch = (Math.max(nr, ng, nb) - Math.min(nr, ng, nb)) / 255;
        let k = s;
        if (ch > 0.16) {
          const t = Math.min(1, (ch - 0.16) / 0.24);
          k = s * (1 - t * t * (3 - 2 * t));
        }
        d[i] = r + (nr - r) * k;
        d[i + 1] = gg + (ng - gg) * k;
        d[i + 2] = b + (nb - b) * k;
      }
    }

    // Couleur du blanc : médiane par canal des pixels les plus clairs autour du clic (ignore l'encre voisine)
    function sampleWhite(px, py) {
      const R = Math.max(4, Math.round(wb.base.width * 0.006));
      const x0 = Math.max(0, Math.round(px) - R), y0 = Math.max(0, Math.round(py) - R);
      const x1 = Math.min(wb.base.width, Math.round(px) + R + 1), y1 = Math.min(wb.base.height, Math.round(py) + R + 1);
      const d = wb.baseCtx.getImageData(x0, y0, Math.max(1, x1 - x0), Math.max(1, y1 - y0)).data;
      const all = [];
      for (let i = 0; i < d.length; i += 4) all.push([d[i], d[i + 1], d[i + 2], d[i] * 0.299 + d[i + 1] * 0.587 + d[i + 2] * 0.114]);
      all.sort((a, b) => b[3] - a[3]);
      const top = all.slice(0, Math.max(1, Math.round(all.length * 0.7)));
      const med = c => { const v = top.map(p => p[c]).sort((a, b) => a - b); return v[v.length >> 1]; };
      return [med(0), med(1), med(2)];
    }

    function hitTicket(item, x, y) {
      if (!item) return false;
      if (!isQuadTicket(item)) return x >= item.x && x <= item.x + item.w && y >= item.y && y <= item.y + item.h;
      const c = normalizeFreeform(item).corners;
      let inside = false;
      for (let i = 0, j = c.length - 1; i < c.length; j = i++) {
        if ((c[i][1] > y) !== (c[j][1] > y) && x < (c[j][0] - c[i][0]) * (y - c[i][1]) / (c[j][1] - c[i][1]) + c[i][0]) inside = !inside;
      }
      return inside;
    }

    function ticketBounds(item, W, H) {
      let x0, y0, x1, y1;
      if (isQuadTicket(item)) {
        const pts = getAllFreeformPoints(normalizeFreeform(item));
        x0 = Math.min(...pts.map(p => p[0])) - 12; x1 = Math.max(...pts.map(p => p[0])) + 12;
        y0 = Math.min(...pts.map(p => p[1])) - 12; y1 = Math.max(...pts.map(p => p[1])) + 12;
      } else { x0 = item.x; y0 = item.y; x1 = item.x + item.w; y1 = item.y + item.h; }
      x0 = Math.max(0, Math.floor(x0)); y0 = Math.max(0, Math.floor(y0));
      x1 = Math.min(W, Math.ceil(x1)); y1 = Math.min(H, Math.ceil(y1));
      return { x: x0, y: y0, w: x1 - x0, h: y1 - y0 };
    }

    // Aperçu : la page d'origine reste intacte dans wb.base ; seul le canvas affiché est recomposé
    function paintTicketWb(ctx, item) {
      const b = ticketBounds(item, wb.base.width, wb.base.height);
      if (b.w < 1 || b.h < 1) return;
      const img = wb.baseCtx.getImageData(b.x, b.y, b.w, b.h);
      applyWbToImageData(img.data, item.wb);
      const tmp = document.createElement('canvas');
      tmp.width = b.w; tmp.height = b.h;
      tmp.getContext('2d').putImageData(img, 0, 0);
      ctx.save();
      if (isQuadTicket(item)) {
        ctx.clip(new Path2D(buildFreeformSvgPath(normalizeFreeform(item))));
      } else {
        ctx.beginPath(); ctx.rect(item.x, item.y, item.w, item.h); ctx.clip();
      }
      ctx.drawImage(tmp, b.x, b.y);
      ctx.restore();
    }

    function drawWbMarkers() {
      dom.quadSvg.querySelectorAll('.wb-marker').forEach(e => e.remove());
      if (!wb.mode) return;
      const ns = 'http://www.w3.org/2000/svg', r = Math.max(7, dom.canvas.width * 0.01);
      (state.frames[state.currentPage] || []).forEach(it => {
        if (!it.wb) return;
        const c = document.createElementNS(ns, 'circle');
        c.setAttribute('cx', it.wb.pt[0]); c.setAttribute('cy', it.wb.pt[1]); c.setAttribute('r', r);
        c.setAttribute('class', 'wb-marker');
        dom.quadSvg.appendChild(c);
      });
    }

    function paintPage() {
      if (!wb.base) return;
      const items = (state.frames[state.currentPage] || []).filter(hasWb);
      if (!items.length && !wb.painted) return;
      const ctx = dom.canvas.getContext('2d');
      ctx.drawImage(wb.base, 0, 0);
      wb.painted = false;
      if (wb.view === 'after') {
        for (const it of items) { paintTicketWb(ctx, it); wb.painted = true; }
      }
      drawWbMarkers();
    }
    function schedulePaint() {
      if (wb.raf) return;
      wb.raf = requestAnimationFrame(() => { wb.raf = 0; paintPage(); });
    }
    function captureBase() {
      const b = document.createElement('canvas');
      b.width = dom.canvas.width; b.height = dom.canvas.height;
      const c = b.getContext('2d', { willReadFrequently: true });
      c.drawImage(dom.canvas, 0, 0);
      wb.base = b; wb.baseCtx = c; wb.painted = false;
      paintPage();
    }
    // Source non corrigée pour la détection automatique des tickets
    function srcCanvas() { return wb.base || dom.canvas; }

    function wbReset() {
      wb.mode = false; wb.view = 'after'; wb.base = null; wb.baseCtx = null; wb.painted = false;
      wb.undo = []; wb.redo = []; wb.dragBefore = null;
      dom.overlay.classList.remove('wb-mode');
      wbDom.btn.classList.remove('is-active');
      setStatus(wbDom.status, '');
      updateWbUI();
    }

    // Historique Annuler / Rétablir (propre à la balance des blancs)
    function wbPush(item, before, after) {
      wb.undo.push({ item, before, after });
      if (wb.undo.length > 200) wb.undo.shift();
      wb.redo.length = 0;
    }
    async function wbApplyHistory(h, value) {
      h.item.wb = cloneWb(value);
      const p = state.frames.findIndex(l => l && l.includes(h.item));
      if (p < 0) { updateWbUI(); return; }
      if (p !== state.currentPage) { state.currentPage = p; await renderCurrentPage(); }
      state.selectedIndex = state.frames[p].indexOf(h.item);
      renderOverlay();
      updateUI();
    }
    function wbUndo() { const h = wb.undo.pop(); if (!h) return; wb.redo.push(h); wbApplyHistory(h, h.before); }
    function wbRedo() { const h = wb.redo.pop(); if (!h) return; wb.undo.push(h); wbApplyHistory(h, h.after); }

    function wbLabel(w) {
      const r = w.ref[0], g = w.ref[1], b = w.ref[2], mx = Math.max(r, g, b), mn = Math.min(r, g, b);
      if (mx >= 248 && mx - mn < 6) return 'déjà blanc';
      if (r - b >= 18) return 'dominante jaune/beige';
      if (mx - mn < 12) return 'dominante grise';
      return 'dominante colorée';
    }

    function updateWbUI() {
      const items = state.frames[state.currentPage] || [];
      const sel = items[state.selectedIndex];
      wbDom.btn.disabled = state.totalPages === 0;
      wbDom.list.innerHTML = '';
      if (!items.length) {
        wbDom.list.innerHTML = '<div class="helper-note">Aucun ticket sur cette page.</div>';
      }
      items.forEach((it, i) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'btn-sm wb-row' + (i === state.selectedIndex ? ' sel' : '');
        const chip = document.createElement('span');
        chip.className = 'wb-chip';
        chip.style.background = it.wb ? 'rgb(' + it.wb.ref.join(',') + ')' : 'transparent';
        const t = document.createElement('span');
        t.textContent = 'Ticket ' + (i + 1) + ' : ' + (it.wb ? wbLabel(it.wb) + ' · ' + Math.round(it.wb.strength * 100) + ' %' : 'aucune correction');
        b.append(chip, t);
        b.addEventListener('click', () => { state.selectedIndex = i; renderOverlay(); updateUI(); });
        wbDom.list.appendChild(b);
      });
      const has = !!(sel && sel.wb);
      wbDom.strength.disabled = !has;
      wbDom.strength.value = has ? Math.round(sel.wb.strength * 100) : 100;
      wbDom.strengthValue.textContent = wbDom.strength.value + ' %';
      wbDom.reset.disabled = !has;
      wbDom.repick.disabled = !sel;
      wbDom.undo.disabled = wb.undo.length === 0;
      wbDom.redo.disabled = wb.redo.length === 0;
      wbDom.viewBefore.classList.toggle('is-active', wb.view === 'before');
      wbDom.viewAfter.classList.toggle('is-active', wb.view === 'after');
    }

    function setWbMode(on) {
      wb.mode = !!on && state.totalPages > 0;
      dom.overlay.classList.toggle('wb-mode', wb.mode);
      wbDom.btn.classList.toggle('is-active', wb.mode);
      setStatus(wbDom.status, wb.mode ? 'Pipette active : cliquez sur une zone qui devrait être blanche, à l’intérieur d’un ticket (Échap pour quitter).' : '', 'info');
      renderOverlay();
      drawWbMarkers();
      updateWbUI();
    }

    // Capture du clic AVANT les interactions de cadrage (déplacement, création de cadres)
    dom.overlay.addEventListener('pointerdown', (e) => {
      if (!wb.mode) return;
      e.preventDefault();
      e.stopImmediatePropagation();
      if (!wb.base || (e.button !== 0 && e.pointerType === 'mouse')) return;
      const pt = clientToCanvasCoords(e.clientX, e.clientY);
      const items = state.frames[state.currentPage] || [];
      let idx = -1;
      if (state.selectedIndex >= 0 && hitTicket(items[state.selectedIndex], pt.x, pt.y)) idx = state.selectedIndex;
      else for (let i = items.length - 1; i >= 0; i--) { if (hitTicket(items[i], pt.x, pt.y)) { idx = i; break; } }
      if (idx < 0) {
        setStatus(wbDom.status, 'Cliquez à l’intérieur d’un ticket (placez d’abord vos cadres).', 'warn');
        return;
      }
      const it = items[idx], before = cloneWb(it.wb);
      it.wb = { ref: sampleWhite(pt.x, pt.y), pt: [pt.x, pt.y], strength: before ? before.strength : 1 };
      wbPush(it, before, cloneWb(it.wb));
      state.selectedIndex = idx;
      setStatus(wbDom.status, 'Ticket ' + (idx + 1) + ' : blanc mesuré RGB(' + it.wb.ref.join(', ') + ') → RGB(255, 255, 255).', 'ok');
      renderOverlay();
      updateUI();
    }, true);

    wbDom.btn.addEventListener('click', () => setWbMode(!wb.mode));
    wbDom.repick.addEventListener('click', () => {
      setWbMode(true);
      setStatus(wbDom.status, 'Cliquez le nouveau point blanc dans le ticket sélectionné.', 'info');
    });
    wbDom.reset.addEventListener('click', () => {
      const it = (state.frames[state.currentPage] || [])[state.selectedIndex];
      if (!it || !it.wb) return;
      wbPush(it, cloneWb(it.wb), null);
      it.wb = null;
      renderOverlay();
      updateUI();
    });
    wbDom.undo.addEventListener('click', wbUndo);
    wbDom.redo.addEventListener('click', wbRedo);
    wbDom.viewBefore.addEventListener('click', () => { wb.view = 'before'; schedulePaint(); updateWbUI(); });
    wbDom.viewAfter.addEventListener('click', () => { wb.view = 'after'; schedulePaint(); updateWbUI(); });
    wbDom.strength.addEventListener('input', () => {
      const it = (state.frames[state.currentPage] || [])[state.selectedIndex];
      if (!it || !it.wb) return;
      if (!wb.dragBefore) wb.dragBefore = cloneWb(it.wb);
      it.wb.strength = wbDom.strength.value / 100;
      wbDom.strengthValue.textContent = wbDom.strength.value + ' %';
      schedulePaint();
    });
    wbDom.strength.addEventListener('change', () => {
      const it = (state.frames[state.currentPage] || [])[state.selectedIndex];
      if (it && it.wb && wb.dragBefore) wbPush(it, wb.dragBefore, cloneWb(it.wb));
      wb.dragBefore = null;
      updateWbUI();
    });
    document.addEventListener('keydown', (e) => {
      if (!wb.mode) return;
      const tag = document.activeElement && document.activeElement.tagName;
      if (tag === 'INPUT' || tag === 'SELECT' || tag === 'TEXTAREA') return;
      if (e.key === 'Escape') setWbMode(false);
      else if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'z') { e.preventDefault(); e.shiftKey ? wbRedo() : wbUndo(); }
      else if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'y') { e.preventDefault(); wbRedo(); }
    });

    // Une forme libre possède 4 coins (corners: [TL, TR, BR, BL]) et 4 listes ordonnées
    // de points intermédiaires par bord (edges: [top[], right[], bottom[], left[]]).
    // Compatibilité ascendante avec les anciens formats quad à 4 ou 8 points.
    function isQuadTicket(item) {
      return Boolean(item && (Array.isArray(item.corners) || Array.isArray(item.quad)));
    }

    function normalizeFreeform(item) {
      if (item.corners && Array.isArray(item.edges) && item.edges.length === 4) {
        return item;
      }
      const q = item.quad || [[0, 0], [100, 0], [100, 100], [0, 100]];
      const [tl, tr, br, bl] = q;
      item.corners = [
        [tl[0], tl[1]],
        [tr[0], tr[1]],
        [br[0], br[1]],
        [bl[0], bl[1]]
      ];
      if (q.length === 8) {
        item.edges = [
          [[q[4][0], q[4][1]]],
          [[q[5][0], q[5][1]]],
          [[q[6][0], q[6][1]]],
          [[q[7][0], q[7][1]]]
        ];
      } else {
        item.edges = [
          [[Math.round((tl[0] + tr[0]) / 2), Math.round((tl[1] + tr[1]) / 2)]],
          [[Math.round((tr[0] + br[0]) / 2), Math.round((tr[1] + br[1]) / 2)]],
          [[Math.round((br[0] + bl[0]) / 2), Math.round((br[1] + bl[1]) / 2)]],
          [[Math.round((bl[0] + tl[0]) / 2), Math.round((bl[1] + tl[1]) / 2)]]
        ];
      }
      delete item.quad;
      return item;
    }

    function cloneFreeform(item) {
      const f = normalizeFreeform(item);
      return {
        corners: f.corners.map(p => [p[0], p[1]]),
        edges: f.edges.map(edge => edge.map(p => [p[0], p[1]]))
      };
    }

    function getAllFreeformPoints(item) {
      const f = normalizeFreeform(item);
      return [
        ...f.corners,
        ...f.edges[0],
        ...f.edges[1],
        ...f.edges[2],
        ...f.edges[3]
      ];
    }

    // Spline de Catmull-Rom centripète (sans boucles ni dépassements) sur une chaîne de points
    function evalCatmullRomChain(chain, t) {
      const n = chain.length;
      if (n === 0) return [0, 0];
      if (n === 1) return [chain[0][0], chain[0][1]];
      if (t <= 0) return [chain[0][0], chain[0][1]];
      if (t >= 1) return [chain[n - 1][0], chain[n - 1][1]];
      if (n === 2) {
        return [
          chain[0][0] + (chain[1][0] - chain[0][0]) * t,
          chain[0][1] + (chain[1][1] - chain[0][1]) * t
        ];
      }

      // Paramétrisation par longueur d'arc cumulée
      const cum = new Float64Array(n);
      for (let i = 1; i < n; i++) {
        cum[i] = cum[i - 1] + Math.max(1e-4, Math.hypot(chain[i][0] - chain[i - 1][0], chain[i][1] - chain[i - 1][1]));
      }
      const totalLen = cum[n - 1];
      const targetLen = t * totalLen;

      let seg = 0;
      while (seg < n - 2 && cum[seg + 1] < targetLen) seg++;
      const segLen = Math.max(1e-6, cum[seg + 1] - cum[seg]);
      const u = (targetLen - cum[seg]) / segLen;

      const p1 = chain[seg];
      const p2 = chain[seg + 1];
      const p0 = seg > 0 ? chain[seg - 1] : [2 * p1[0] - p2[0], 2 * p1[1] - p2[1]];
      const p3 = seg + 2 < n ? chain[seg + 2] : [2 * p2[0] - p1[0], 2 * p2[1] - p1[1]];

      const u2 = u * u;
      const u3 = u2 * u;
      const b0 = -0.5 * u3 + u2 - 0.5 * u;
      const b1 = 1.5 * u3 - 2.5 * u2 + 1.0;
      const b2 = -1.5 * u3 + 2.0 * u2 + 0.5 * u;
      const b3 = 0.5 * u3 - 0.5 * u2;

      return [
        b0 * p0[0] + b1 * p1[0] + b2 * p2[0] + b3 * p3[0],
        b0 * p0[1] + b1 * p1[1] + b2 * p2[1] + b3 * p3[1]
      ];
    }

    // Construit les 4 chaînes orientées dans le sens du patch de Coons :
    // 0: Haut (TL -> TR), 1: Droit (TR -> BR), 2: Bas (BL -> BR), 3: Gauche (TL -> BL)
    function getFreeformChains(item) {
      const f = normalizeFreeform(item);
      const [tl, tr, br, bl] = f.corners;
      return [
        [tl, ...f.edges[0], tr],
        [tr, ...f.edges[1], br],
        [bl, ...f.edges[2].slice().reverse(), br],
        [tl, ...f.edges[3].slice().reverse(), bl]
      ];
    }

    // Génère le chemin SVG d'un bord individuel (pour hit-testing d'ajout de point)
    function buildSingleEdgeSvgPath(chain) {
      if (chain.length <= 2) {
        return `M ${chain[0][0]} ${chain[0][1]} L ${chain[chain.length - 1][0]} ${chain[chain.length - 1][1]}`;
      }
      const steps = Math.max(12, (chain.length - 1) * 10);
      const cmds = [`M ${chain[0][0]} ${chain[0][1]}`];
      for (let i = 1; i <= steps; i++) {
        const pt = evalCatmullRomChain(chain, i / steps);
        cmds.push(`L ${pt[0].toFixed(1)} ${pt[1].toFixed(1)}`);
      }
      return cmds.join(' ');
    }

    // Génère le contour complet fermé d'une forme libre à N points
    function buildFreeformSvgPath(item) {
      const f = normalizeFreeform(item);
      const [tl, tr, br, bl] = f.corners;
      const orderedChains = [
        [tl, ...f.edges[0], tr],
        [tr, ...f.edges[1], br],
        [br, ...f.edges[2], bl],
        [bl, ...f.edges[3], tl]
      ];
      const cmds = [`M ${tl[0]} ${tl[1]}`];
      for (const chain of orderedChains) {
        if (chain.length <= 2) {
          const end = chain[chain.length - 1];
          cmds.push(`L ${end[0]} ${end[1]}`);
        } else {
          const steps = Math.max(12, (chain.length - 1) * 10);
          for (let i = 1; i <= steps; i++) {
            const pt = evalCatmullRomChain(chain, i / steps);
            cmds.push(`L ${pt[0].toFixed(1)} ${pt[1].toFixed(1)}`);
          }
        }
      }
      cmds.push('Z');
      return cmds.join(' ');
    }

    // Projection d'un point P sur un segment [A, B] -> paramètre t dans [0, 1] et distance au carré
    function projectPointOnSegment(px, py, ax, ay, bx, by) {
      const dx = bx - ax;
      const dy = by - ay;
      const lenSq = dx * dx + dy * dy;
      if (lenSq < 1e-6) return { t: 0, distSq: (px - ax) ** 2 + (py - ay) ** 2 };
      const t = Math.max(0, Math.min(1, ((px - ax) * dx + (py - ay) * dy) / lenSq));
      const projX = ax + t * dx;
      const projY = ay + t * dy;
      return { t, distSq: (px - projX) ** 2 + (py - projY) ** 2 };
    }

    // Insère un nouveau point au bon emplacement dans la chaîne d'un bord (edgeIdx: 0..3)
    function insertPointOnEdge(item, edgeIdx, pt) {
      const f = normalizeFreeform(item);
      const [tl, tr, br, bl] = f.corners;
      const ends = [
        [tl, tr],
        [tr, br],
        [br, bl],
        [bl, tl]
      ][edgeIdx];
      const fullChain = [ends[0], ...f.edges[edgeIdx], ends[1]];

      let bestSeg = 0;
      let bestDistSq = Infinity;
      for (let i = 0; i < fullChain.length - 1; i++) {
        const res = projectPointOnSegment(
          pt[0], pt[1],
          fullChain[i][0], fullChain[i][1],
          fullChain[i + 1][0], fullChain[i + 1][1]
        );
        if (res.distSq < bestDistSq) {
          bestDistSq = res.distSq;
          bestSeg = i;
        }
      }

      const newPt = [Math.round(pt[0]), Math.round(pt[1])];
      f.edges[edgeIdx].splice(bestSeg, 0, newPt);
      return bestSeg;
    }

    function setExportProgress(ratio) {
      if (ratio === null || ratio === undefined) {
        dom.exportProgressWrap.classList.add('hidden');
        dom.exportProgressBar.style.width = '0%';
      } else {
        dom.exportProgressWrap.classList.remove('hidden');
        dom.exportProgressBar.style.width = `${Math.max(0, Math.min(100, Math.round(ratio * 100)))}%`;
      }
    }

    // Gestion du thème clair / sombre
    dom.btnTheme.addEventListener('click', () => {
      const root = document.documentElement;
      const current = root.getAttribute('data-theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (!current) {
        root.setAttribute('data-theme', prefersDark ? 'light' : 'dark');
      } else if (current === 'dark') {
        root.setAttribute('data-theme', 'light');
      } else {
        root.setAttribute('data-theme', 'dark');
      }
    });

    // Gestion des messages d'état
    function showDropError(msg) {
      dom.dropError.textContent = msg;
      dom.dropError.classList.remove('hidden');
    }

    function clearDropError() {
      dom.dropError.textContent = '';
      dom.dropError.classList.add('hidden');
    }

    function setStatus(el, msg, type = 'info') {
      if (!msg) {
        el.classList.add('hidden');
        el.textContent = '';
        return;
      }
      el.textContent = msg;
      el.className = 'status-msg';
      if (type === 'warn') el.classList.add('warn');
      if (type === 'ok') el.classList.add('ok');
      el.classList.remove('hidden');
    }

    // Extraction du nom de fichier propre
    function sanitizeBaseName(filename) {
      const noExt = filename.replace(/\.[^/.]+$/, '');
      return noExt.replace(/[^a-zA-Z0-9À-ÿ_-]+/g, '-').replace(/^-+|-+$/g, '') || 'tickets';
    }

    // Chargement des fichiers (clic et glisser-déposer)
    dom.dropZone.addEventListener('click', () => dom.fileInput.click());
    dom.dropZone.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        dom.fileInput.click();
      }
    });

    dom.dropZone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dom.dropZone.classList.add('dragover');
    });

    dom.dropZone.addEventListener('dragleave', () => {
      dom.dropZone.classList.remove('dragover');
    });

    dom.dropZone.addEventListener('drop', (e) => {
      e.preventDefault();
      dom.dropZone.classList.remove('dragover');
      if (e.dataTransfer?.files?.length) {
        handleFiles(Array.from(e.dataTransfer.files));
      }
    });

    dom.fileInput.addEventListener('change', (e) => {
      if (e.target.files?.length) {
        handleFiles(Array.from(e.target.files));
      }
      dom.fileInput.value = '';
    });

    dom.btnResetFile.addEventListener('click', () => {
      resetState();
      dom.workspaceView.classList.add('hidden');
      dom.btnResetFile.classList.add('hidden');
      dom.dropView.classList.remove('hidden');
    });

    function resetState() {
      state.mode = null;
      state.baseName = 'tickets';
      state.totalPages = 0;
      state.currentPage = 0;
      state.pdfDoc = null;
      state.pdfBytes = null;
      state.images = [];
      state.pageDimensions = [];
      state.frames = [];
      state.selectedIndex = -1;
      state.pdfHighResCache.clear();
      wbReset();
      dom.overlay.querySelectorAll('.ticket-box').forEach(el => el.remove());
      dom.quadSvg.innerHTML = '';
      setStatus(dom.detectStatus, '');
      setStatus(dom.skewStatus, '');
      setStatus(dom.exportStatus, '');
      setExportProgress(null);
      clearDropError();
    }

    async function handleFiles(files) {
      clearDropError();
      const allowedTypes = ['application/pdf', 'image/png', 'image/jpeg', 'image/webp'];
      const validFiles = files.filter(f =>
        allowedTypes.includes(f.type) || /\.(pdf|png|jpe?g|webp)$/i.test(f.name)
      );

      if (validFiles.length === 0) {
        showDropError('Format non supporté. Veuillez sélectionner un fichier PDF ou des images (PNG, JPG, WebP).');
        return;
      }

      const pdfFile = validFiles.find(f => f.type === 'application/pdf' || /\.pdf$/i.test(f.name));

      try {
        resetState();
        if (pdfFile) {
          await loadPdfFile(pdfFile);
        } else {
          await loadImageFiles(validFiles);
        }

        dom.dropView.classList.add('hidden');
        dom.workspaceView.classList.remove('hidden');
        dom.btnResetFile.classList.remove('hidden');
        await renderCurrentPage();
        updateUI();
      } catch (err) {
        console.error(err);
        showDropError('Impossible de lire le fichier : ' + (err.message || 'fichier corrompu ou protégé.'));
      }
    }

    async function loadPdfFile(file) {
      if (!window.pdfjsLib) {
        throw new Error('La bibliothèque PDF.js n’a pas pu être chargée.');
      }
      const arrayBuffer = await file.arrayBuffer();
      state.pdfBytes = arrayBuffer.slice(0);
      const loadingTask = pdfjsLib.getDocument({ data: arrayBuffer });
      const pdf = await loadingTask.promise;

      state.mode = 'pdf';
      state.baseName = sanitizeBaseName(file.name);
      state.pdfDoc = pdf;
      state.totalPages = pdf.numPages;
      state.frames = Array.from({ length: pdf.numPages }, () => []);
      state.pageDimensions = new Array(pdf.numPages).fill(null);
      dom.exportFormat.value = 'pdf';
    }

    async function loadImageFiles(files) {
      const loadedImages = [];
      for (const file of files) {
        const img = await readImageElement(file);
        const maxSide = Math.max(img.naturalWidth, img.naturalHeight);
        const scale = maxSide > MAX_IMG_DISPLAY_DIM ? (MAX_IMG_DISPLAY_DIM / maxSide) : 1;
        const displayW = Math.round(img.naturalWidth * scale);
        const displayH = Math.round(img.naturalHeight * scale);
        loadedImages.push({
          img,
          width: img.naturalWidth,
          height: img.naturalHeight,
          scale,
          displayW,
          displayH
        });
      }

      state.mode = 'img';
      state.baseName = sanitizeBaseName(files[0].name);
      state.images = loadedImages;
      state.totalPages = loadedImages.length;
      state.frames = Array.from({ length: loadedImages.length }, () => []);
      state.pageDimensions = loadedImages.map(item => ({
        width: item.displayW,
        height: item.displayH
      }));
      dom.exportFormat.value = 'png';
    }

    function readImageElement(file) {
      return new Promise((resolve, reject) => {
        const url = URL.createObjectURL(file);
        const img = new Image();
        img.onload = () => {
          URL.revokeObjectURL(url);
          resolve(img);
        };
        img.onerror = () => {
          URL.revokeObjectURL(url);
          reject(new Error(`Échec du chargement de l’image « ${file.name} ».`));
        };
        img.src = url;
      });
    }

    // Rendu de la page courante sur le canvas principal
    async function renderCurrentPage() {
      const idx = state.currentPage;
      const ctx = dom.canvas.getContext('2d');

      if (state.mode === 'pdf') {
        const page = await state.pdfDoc.getPage(idx + 1);
        const viewport = page.getViewport({ scale: PDF_DISPLAY_SCALE });
        dom.canvas.width = Math.round(viewport.width);
        dom.canvas.height = Math.round(viewport.height);
        state.pageDimensions[idx] = { width: dom.canvas.width, height: dom.canvas.height };

        ctx.fillStyle = '#ffffff';
        ctx.fillRect(0, 0, dom.canvas.width, dom.canvas.height);
        await page.render({ canvasContext: ctx, viewport }).promise;
      } else if (state.mode === 'img') {
        const item = state.images[idx];
        dom.canvas.width = item.displayW;
        dom.canvas.height = item.displayH;
        ctx.clearRect(0, 0, dom.canvas.width, dom.canvas.height);
        ctx.drawImage(item.img, 0, 0, item.displayW, item.displayH);
      }

      captureBase();
      renderOverlay();
    }

    // Rendu hors écran d'une page quelconque (pour détection automatique globale)
    async function renderPageOffscreen(pageIdx) {
      const offCanvas = document.createElement('canvas');
      const ctx = offCanvas.getContext('2d');

      if (state.mode === 'pdf') {
        const page = await state.pdfDoc.getPage(pageIdx + 1);
        const viewport = page.getViewport({ scale: PDF_DISPLAY_SCALE });
        offCanvas.width = Math.round(viewport.width);
        offCanvas.height = Math.round(viewport.height);
        state.pageDimensions[pageIdx] = { width: offCanvas.width, height: offCanvas.height };
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(0, 0, offCanvas.width, offCanvas.height);
        await page.render({ canvasContext: ctx, viewport }).promise;
      } else {
        const item = state.images[pageIdx];
        offCanvas.width = item.displayW;
        offCanvas.height = item.displayH;
        ctx.drawImage(item.img, 0, 0, item.displayW, item.displayH);
      }
      return offCanvas;
    }

    // Mise à jour de la navigation, des compteurs et de l'état des boutons
    function updateUI() {
      const unitLabel = state.mode === 'img' ? 'Image' : 'Page';
      dom.pageLabel.textContent = `${unitLabel} ${state.currentPage + 1} / ${state.totalPages}`;
      dom.btnPrev.disabled = state.currentPage <= 0;
      dom.btnNext.disabled = state.currentPage >= state.totalPages - 1;

      const pageFrames = state.frames[state.currentPage] || [];
      const totalTickets = state.frames.reduce((sum, list) => sum + list.length, 0);

      const pageWord = pageFrames.length > 1 ? 'tickets' : 'ticket';
      dom.ticketCounter.textContent = `${pageFrames.length} ${pageWord} sur cette page · ${totalTickets} au total`;

      const hasSelection = state.selectedIndex >= 0 && state.selectedIndex < pageFrames.length;
      const selectedItem = hasSelection ? pageFrames[state.selectedIndex] : null;
      dom.btnDupFrame.disabled = !hasSelection;
      dom.btnToQuad.disabled = !hasSelection || isQuadTicket(selectedItem);
      dom.btnClearPage.disabled = pageFrames.length === 0;
      dom.btnExportZip.disabled = totalTickets === 0;
      dom.btnExportPdf.disabled = totalTickets === 0;
      updateWbUI();
    }

    // Navigation entre les pages / images
    dom.btnPrev.addEventListener('click', async () => {
      if (state.currentPage > 0) {
        state.currentPage--;
        state.selectedIndex = -1;
        await renderCurrentPage();
        updateUI();
      }
    });

    dom.btnNext.addEventListener('click', async () => {
      if (state.currentPage < state.totalPages - 1) {
        state.currentPage++;
        state.selectedIndex = -1;
        await renderCurrentPage();
        updateUI();
      }
    });

    // Affichage des cadres rectangulaires (HTML) et formes libres à N points (SVG) dans l'overlay
    function renderOverlay() {
      dom.overlay.querySelectorAll('.ticket-box').forEach(el => el.remove());
      dom.quadSvg.innerHTML = '';
      schedulePaint();

      const dims = state.pageDimensions[state.currentPage];
      if (!dims) return;

      dom.quadSvg.setAttribute('viewBox', `0 0 ${dims.width} ${dims.height}`);
      const svgNS = 'http://www.w3.org/2000/svg';
      const handleRadius = Math.max(5, Math.min(9, dims.width * 0.0085));
      const badgeScale = Math.max(1, dims.width / 760);

      const pageFrames = state.frames[state.currentPage] || [];
      const handles = ['nw', 'n', 'ne', 'e', 'se', 's', 'sw', 'w'];

      pageFrames.forEach((item, idx) => {
        const isSelected = idx === state.selectedIndex;

        if (isQuadTicket(item)) {
          const ff = normalizeFreeform(item);
          const [tl, tr, br, bl] = ff.corners;
          const pathEl = document.createElementNS(svgNS, 'path');
          pathEl.setAttribute('d', buildFreeformSvgPath(ff));
          pathEl.setAttribute('class', 'quad-poly' + (isSelected ? ' selected' : ''));
          pathEl.dataset.index = idx;
          dom.quadSvg.appendChild(pathEl);

          // Badge numéro près du coin haut-gauche (tl)
          const badgeGroup = document.createElementNS(svgNS, 'g');
          badgeGroup.setAttribute('class', 'quad-badge-group');
          const bx = Math.max(0, Math.min(dims.width - 24 * badgeScale, tl[0]));
          const by = Math.max(0, Math.min(dims.height - 18 * badgeScale, tl[1]));
          badgeGroup.setAttribute('transform', `translate(${bx}, ${by}) scale(${badgeScale})`);

          const badgeRect = document.createElementNS(svgNS, 'rect');
          badgeRect.setAttribute('width', '22');
          badgeRect.setAttribute('height', '17');
          badgeRect.setAttribute('rx', '3');
          badgeRect.setAttribute('fill', isSelected ? '#f59e0b' : '#2563eb');
          badgeGroup.appendChild(badgeRect);

          const badgeText = document.createElementNS(svgNS, 'text');
          badgeText.setAttribute('x', '11');
          badgeText.setAttribute('y', '12.5');
          badgeText.setAttribute('text-anchor', 'middle');
          badgeText.setAttribute('font-size', '11');
          badgeText.setAttribute('font-weight', '700');
          badgeText.setAttribute('font-family', 'sans-serif');
          badgeText.setAttribute('fill', isSelected ? '#111827' : '#ffffff');
          badgeText.textContent = String(idx + 1);
          badgeGroup.appendChild(badgeText);
          dom.quadSvg.appendChild(badgeGroup);

          // Bouton suppression × près du coin haut-droit (tr)
          const delGroup = document.createElementNS(svgNS, 'g');
          delGroup.setAttribute('class', 'quad-del-group');
          delGroup.dataset.index = idx;
          const dx = Math.max(0, Math.min(dims.width - 20 * badgeScale, tr[0] - 20 * badgeScale));
          const dy = Math.max(0, Math.min(dims.height - 20 * badgeScale, tr[1]));
          delGroup.setAttribute('transform', `translate(${dx}, ${dy}) scale(${badgeScale})`);

          const delRect = document.createElementNS(svgNS, 'rect');
          delRect.setAttribute('width', '20');
          delRect.setAttribute('height', '20');
          delRect.setAttribute('rx', '4');
          delRect.setAttribute('fill', '#dc2626');
          delGroup.appendChild(delRect);

          const delText = document.createElementNS(svgNS, 'text');
          delText.setAttribute('x', '10');
          delText.setAttribute('y', '14.5');
          delText.setAttribute('text-anchor', 'middle');
          delText.setAttribute('font-size', '14');
          delText.setAttribute('font-weight', '700');
          delText.setAttribute('font-family', 'sans-serif');
          delText.setAttribute('fill', '#ffffff');
          delText.textContent = '×';
          delGroup.appendChild(delText);

          delGroup.addEventListener('pointerdown', (e) => e.stopPropagation());
          delGroup.addEventListener('click', (e) => {
            e.stopPropagation();
            deleteFrame(idx);
          });
          dom.quadSvg.appendChild(delGroup);

          // Si sélectionné : zones cliquables sur les 4 bords pour ajouter un point + poignées des coins et bords
          if (isSelected) {
            const edgeChains = [
              [tl, ...ff.edges[0], tr],
              [tr, ...ff.edges[1], br],
              [br, ...ff.edges[2], bl],
              [bl, ...ff.edges[3], tl]
            ];

            edgeChains.forEach((chain, edgeIdx) => {
              const hitPath = document.createElementNS(svgNS, 'path');
              hitPath.setAttribute('d', buildSingleEdgeSvgPath(chain));
              hitPath.setAttribute('class', 'quad-edge-hit');
              hitPath.dataset.index = idx;
              hitPath.dataset.edge = edgeIdx;
              dom.quadSvg.appendChild(hitPath);
            });

            // 4 poignées de coins
            ff.corners.forEach((pt, cornerIdx) => {
              const circle = document.createElementNS(svgNS, 'circle');
              circle.setAttribute('cx', pt[0]);
              circle.setAttribute('cy', pt[1]);
              circle.setAttribute('r', handleRadius);
              circle.setAttribute('class', 'quad-handle');
              circle.dataset.index = idx;
              circle.dataset.kind = 'corner';
              circle.dataset.corner = cornerIdx;
              dom.quadSvg.appendChild(circle);
            });

            // Poignées intermédiaires (nombre illimité par bord)
            ff.edges.forEach((edgePts, edgeIdx) => {
              edgePts.forEach((pt, ptIdx) => {
                const circle = document.createElementNS(svgNS, 'circle');
                circle.setAttribute('cx', pt[0]);
                circle.setAttribute('cy', pt[1]);
                circle.setAttribute('r', handleRadius * 0.85);
                circle.setAttribute('class', 'quad-handle');
                circle.setAttribute('fill', '#fef3c7');
                circle.dataset.index = idx;
                circle.dataset.kind = 'edge-pt';
                circle.dataset.edge = edgeIdx;
                circle.dataset.ptIndex = ptIdx;
                dom.quadSvg.appendChild(circle);
              });
            });
          }
          return;
        }

        // Rendu classique pour cadre rectangulaire
        const f = item;
        const box = document.createElement('div');
        box.className = 'ticket-box' + (isSelected ? ' selected' : '');
        box.dataset.index = idx;
        box.style.left = `${(f.x / dims.width) * 100}%`;
        box.style.top = `${(f.y / dims.height) * 100}%`;
        box.style.width = `${(f.w / dims.width) * 100}%`;
        box.style.height = `${(f.h / dims.height) * 100}%`;

        const badge = document.createElement('span');
        badge.className = 'ticket-badge';
        badge.textContent = idx + 1;
        box.appendChild(badge);

        const delBtn = document.createElement('button');
        delBtn.type = 'button';
        delBtn.className = 'ticket-delete';
        delBtn.title = 'Supprimer ce ticket';
        delBtn.textContent = '×';
        delBtn.addEventListener('pointerdown', (e) => {
          e.stopPropagation();
        });
        delBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          deleteFrame(idx);
        });
        box.appendChild(delBtn);

        handles.forEach((dir) => {
          const h = document.createElement('div');
          h.className = `resize-handle handle-${dir}`;
          h.dataset.dir = dir;
          box.appendChild(h);
        });

        dom.overlay.appendChild(box);
      });
    }

    function deleteFrame(idx) {
      const pageFrames = state.frames[state.currentPage];
      if (!pageFrames || idx < 0 || idx >= pageFrames.length) return;
      pageFrames.splice(idx, 1);
      if (state.selectedIndex === idx) {
        state.selectedIndex = -1;
      } else if (state.selectedIndex > idx) {
        state.selectedIndex--;
      }
      renderOverlay();
      updateUI();
    }

    // Raccourci clavier Suppr / Retour arrière
    document.addEventListener('keydown', (e) => {
      if (dom.workspaceView.classList.contains('hidden')) return;
      const tag = document.activeElement?.tagName;
      if (tag === 'INPUT' || tag === 'SELECT' || tag === 'TEXTAREA') return;

      if ((e.key === 'Delete' || e.key === 'Backspace') && state.selectedIndex >= 0) {
        e.preventDefault();
        deleteFrame(state.selectedIndex);
      }
    });

    // Interactions Pointer Events : création, déplacement, redimensionnement
    let interaction = null;

    function clientToCanvasCoords(clientX, clientY) {
      const rect = dom.overlay.getBoundingClientRect();
      const dims = state.pageDimensions[state.currentPage];
      const scaleX = dims.width / rect.width;
      const scaleY = dims.height / rect.height;
      return {
        x: Math.max(0, Math.min(dims.width, (clientX - rect.left) * scaleX)),
        y: Math.max(0, Math.min(dims.height, (clientY - rect.top) * scaleY))
      };
    }

    dom.overlay.addEventListener('pointerdown', (e) => {
      if (e.button !== 0 && e.pointerType === 'mouse') return;
      const dims = state.pageDimensions[state.currentPage];
      if (!dims) return;

      const quadHandleEl = e.target.closest('.quad-handle');
      const quadEdgeHitEl = e.target.closest('.quad-edge-hit');
      const quadPolyEl = e.target.closest('.quad-poly');
      const handleEl = e.target.closest('.resize-handle');
      const boxEl = e.target.closest('.ticket-box');
      const pt = clientToCanvasCoords(e.clientX, e.clientY);

      if (quadHandleEl) {
        // Déplacement libre d'un coin ou d'un point intermédiaire de bord
        const idx = Number(quadHandleEl.dataset.index);
        const kind = quadHandleEl.dataset.kind;
        state.selectedIndex = idx;
        normalizeFreeform(state.frames[state.currentPage][idx]);
        interaction = {
          type: 'quad-point',
          index: idx,
          kind,
          corner: Number(quadHandleEl.dataset.corner),
          edge: Number(quadHandleEl.dataset.edge),
          ptIndex: Number(quadHandleEl.dataset.ptIndex)
        };
        dom.overlay.setPointerCapture(e.pointerId);
        renderOverlay();
        updateUI();
        return;
      }

      if (quadEdgeHitEl) {
        // Clic sur un bord : création immédiate d'un nouveau point et début du glissement
        const idx = Number(quadEdgeHitEl.dataset.index);
        const edgeIdx = Number(quadEdgeHitEl.dataset.edge);
        state.selectedIndex = idx;
        const ff = normalizeFreeform(state.frames[state.currentPage][idx]);
        const newPtIndex = insertPointOnEdge(ff, edgeIdx, [pt.x, pt.y]);
        interaction = {
          type: 'quad-point',
          index: idx,
          kind: 'edge-pt',
          edge: edgeIdx,
          ptIndex: newPtIndex
        };
        dom.overlay.setPointerCapture(e.pointerId);
        renderOverlay();
        updateUI();
        return;
      }

      if (quadPolyEl) {
        // Sélection et déplacement entier d'une forme libre
        const idx = Number(quadPolyEl.dataset.index);
        state.selectedIndex = idx;
        const origClone = cloneFreeform(state.frames[state.currentPage][idx]);
        interaction = {
          type: 'quad-move',
          index: idx,
          startPt: pt,
          origClone
        };
        dom.overlay.setPointerCapture(e.pointerId);
        renderOverlay();
        updateUI();
        return;
      }

      if (handleEl && boxEl) {
        // Redimensionnement via une poignée
        const idx = Number(boxEl.dataset.index);
        state.selectedIndex = idx;
        const orig = { ...state.frames[state.currentPage][idx] };
        interaction = {
          type: 'resize',
          dir: handleEl.dataset.dir,
          index: idx,
          startPt: pt,
          orig
        };
        dom.overlay.setPointerCapture(e.pointerId);
        renderOverlay();
        updateUI();
        return;
      }

      if (boxEl) {
        // Sélection et déplacement d'un cadre existant
        const idx = Number(boxEl.dataset.index);
        state.selectedIndex = idx;
        const orig = { ...state.frames[state.currentPage][idx] };
        interaction = {
          type: 'move',
          index: idx,
          startPt: pt,
          orig
        };
        dom.overlay.setPointerCapture(e.pointerId);
        renderOverlay();
        updateUI();
        return;
      }

      // Tracé d'un nouveau cadre sur zone vide
      state.selectedIndex = -1;
      const newFrame = { x: pt.x, y: pt.y, w: 0, h: 0 };
      const pageFrames = state.frames[state.currentPage];
      pageFrames.push(newFrame);
      const newIdx = pageFrames.length - 1;

      interaction = {
        type: 'create',
        index: newIdx,
        startPt: pt
      };
      dom.overlay.setPointerCapture(e.pointerId);
      renderOverlay();
      updateUI();
    });

    dom.overlay.addEventListener('pointermove', (e) => {
      if (!interaction) return;
      const dims = state.pageDimensions[state.currentPage];
      const pt = clientToCanvasCoords(e.clientX, e.clientY);
      const pageFrames = state.frames[state.currentPage];
      const frame = pageFrames[interaction.index];
      if (!frame) return;

      if (interaction.type === 'quad-point') {
        const ff = normalizeFreeform(frame);
        const newPt = [
          Math.max(0, Math.min(dims.width, Math.round(pt.x))),
          Math.max(0, Math.min(dims.height, Math.round(pt.y)))
        ];

        if (interaction.kind === 'corner') {
          const cIdx = interaction.corner;
          const prevPt = ff.corners[cIdx];
          const dx = newPt[0] - prevPt[0];
          const dy = newPt[1] - prevPt[1];
          ff.corners[cIdx] = newPt;

          // Déplacement pondéré des points intermédiaires des deux bords adjacents
          const adjEdges = [
            { edgeIdx: cIdx, fromStart: true },
            { edgeIdx: (cIdx + 3) % 4, fromStart: false }
          ];
          for (const { edgeIdx, fromStart } of adjEdges) {
            const list = ff.edges[edgeIdx];
            const n = list.length;
            for (let k = 0; k < n; k++) {
              const t = fromStart ? (k + 1) / (n + 1) : (n - k) / (n + 1);
              const weight = 1 - t;
              list[k] = [
                Math.max(0, Math.min(dims.width, Math.round(list[k][0] + dx * weight))),
                Math.max(0, Math.min(dims.height, Math.round(list[k][1] + dy * weight)))
              ];
            }
          }
        } else {
          ff.edges[interaction.edge][interaction.ptIndex] = newPt;
        }
      } else if (interaction.type === 'quad-move') {
        let dx = pt.x - interaction.startPt.x;
        let dy = pt.y - interaction.startPt.y;
        const allPts = getAllFreeformPoints(interaction.origClone);
        const xs = allPts.map(p => p[0]);
        const ys = allPts.map(p => p[1]);
        const minX = Math.min(...xs), maxX = Math.max(...xs);
        const minY = Math.min(...ys), maxY = Math.max(...ys);
        dx = Math.max(-minX, Math.min(dims.width - maxX, dx));
        dy = Math.max(-minY, Math.min(dims.height - maxY, dy));

        frame.corners = interaction.origClone.corners.map(p => [
          Math.round(p[0] + dx),
          Math.round(p[1] + dy)
        ]);
        frame.edges = interaction.origClone.edges.map(edge =>
          edge.map(p => [Math.round(p[0] + dx), Math.round(p[1] + dy)])
        );
      } else if (interaction.type === 'create') {
        const x1 = Math.min(interaction.startPt.x, pt.x);
        const y1 = Math.min(interaction.startPt.y, pt.y);
        const x2 = Math.max(interaction.startPt.x, pt.x);
        const y2 = Math.max(interaction.startPt.y, pt.y);
        frame.x = x1;
        frame.y = y1;
        frame.w = x2 - x1;
        frame.h = y2 - y1;
      } else if (interaction.type === 'move') {
        const dx = pt.x - interaction.startPt.x;
        const dy = pt.y - interaction.startPt.y;
        frame.x = Math.max(0, Math.min(dims.width - interaction.orig.w, interaction.orig.x + dx));
        frame.y = Math.max(0, Math.min(dims.height - interaction.orig.h, interaction.orig.y + dy));
      } else if (interaction.type === 'resize') {
        const minSize = 10;
        let { x, y, w, h } = interaction.orig;
        const right = x + w;
        const bottom = y + h;
        const dir = interaction.dir;

        if (dir.includes('w')) {
          const newX = Math.max(0, Math.min(right - minSize, pt.x));
          w = right - newX;
          x = newX;
        }
        if (dir.includes('e')) {
          w = Math.max(minSize, Math.min(dims.width - x, pt.x - x));
        }
        if (dir.includes('n')) {
          const newY = Math.max(0, Math.min(bottom - minSize, pt.y));
          h = bottom - newY;
          y = newY;
        }
        if (dir.includes('s')) {
          h = Math.max(minSize, Math.min(dims.height - y, pt.y - y));
        }

        frame.x = x;
        frame.y = y;
        frame.w = w;
        frame.h = h;
      }

      renderOverlay();
    });

    dom.overlay.addEventListener('pointerup', (e) => {
      if (!interaction) return;
      try {
        dom.overlay.releasePointerCapture(e.pointerId);
      } catch (_) {}

      const pageFrames = state.frames[state.currentPage];
      if (interaction.type === 'create') {
        const created = pageFrames[interaction.index];
        // Ignorer les cadres de moins de 15 px
        if (!created || created.w < 15 || created.h < 15) {
          pageFrames.splice(interaction.index, 1);
          state.selectedIndex = -1;
        } else {
          state.selectedIndex = interaction.index;
        }
      }

      interaction = null;
      renderOverlay();
      updateUI();
    });

    dom.overlay.addEventListener('pointercancel', () => {
      interaction = null;
    });

    // Double-clic ou clic droit sur un point intermédiaire pour le supprimer
    function removeIntermediatePointFromEvent(e) {
      const handleEl = e.target.closest('.quad-handle');
      if (!handleEl || handleEl.dataset.kind !== 'edge-pt') return false;
      e.preventDefault();
      e.stopPropagation();
      const idx = Number(handleEl.dataset.index);
      const edgeIdx = Number(handleEl.dataset.edge);
      const ptIdx = Number(handleEl.dataset.ptIndex);
      const item = state.frames[state.currentPage]?.[idx];
      if (!item || !isQuadTicket(item)) return false;
      const ff = normalizeFreeform(item);
      if (ff.edges[edgeIdx] && ptIdx >= 0 && ptIdx < ff.edges[edgeIdx].length) {
        ff.edges[edgeIdx].splice(ptIdx, 1);
        renderOverlay();
        updateUI();
        return true;
      }
      return false;
    }

    dom.overlay.addEventListener('dblclick', (e) => {
      removeIntermediatePointFromEvent(e);
    });

    dom.overlay.addEventListener('contextmenu', (e) => {
      removeIntermediatePointFromEvent(e);
    });

    // Boutons d'édition manuelle : + Cadre, + Forme libre, Dupliquer, Convertir, Tout effacer
    dom.btnAddFrame.addEventListener('click', () => {
      const dims = state.pageDimensions[state.currentPage];
      if (!dims) return;
      const w = Math.round(dims.width * 0.5);
      const h = Math.round(dims.height * 0.3);
      const x = Math.round((dims.width - w) / 2);
      const y = Math.round((dims.height - h) / 2);
      const pageFrames = state.frames[state.currentPage];
      pageFrames.push({ x, y, w, h });
      state.selectedIndex = pageFrames.length - 1;
      renderOverlay();
      updateUI();
    });

    dom.btnAddQuad.addEventListener('click', () => {
      const dims = state.pageDimensions[state.currentPage];
      if (!dims) return;
      const w = Math.round(dims.width * 0.45);
      const h = Math.round(dims.height * 0.28);
      const x = Math.round((dims.width - w) / 2);
      const y = Math.round((dims.height - h) / 2);
      const pageFrames = state.frames[state.currentPage];
      pageFrames.push(normalizeFreeform({
        quad: [
          [x, y],
          [x + w, y],
          [x + w, y + h],
          [x, y + h]
        ]
      }));
      state.selectedIndex = pageFrames.length - 1;
      renderOverlay();
      updateUI();
    });

    dom.btnDupFrame.addEventListener('click', () => {
      const dims = state.pageDimensions[state.currentPage];
      const pageFrames = state.frames[state.currentPage];
      if (!dims || state.selectedIndex < 0 || state.selectedIndex >= pageFrames.length) return;
      const src = pageFrames[state.selectedIndex];

      if (isQuadTicket(src)) {
        const copy = cloneFreeform(src);
        const allPts = getAllFreeformPoints(copy);
        const xs = allPts.map(p => p[0]);
        const ys = allPts.map(p => p[1]);
        const dx = Math.min(20, dims.width - Math.max(...xs));
        const dy = Math.min(20, dims.height - Math.max(...ys));
        copy.corners = copy.corners.map(p => [Math.max(0, p[0] + dx), Math.max(0, p[1] + dy)]);
        copy.edges = copy.edges.map(edge => edge.map(p => [Math.max(0, p[0] + dx), Math.max(0, p[1] + dy)]));
        if (src.wb) copy.wb = cloneWb(src.wb);
        pageFrames.push(copy);
      } else {
        const copy = {
          x: Math.min(dims.width - src.w, src.x + 20),
          y: Math.min(dims.height - src.h, src.y + 20),
          w: src.w,
          h: src.h
        };
        if (src.wb) copy.wb = cloneWb(src.wb);
        pageFrames.push(copy);
      }
      state.selectedIndex = pageFrames.length - 1;
      renderOverlay();
      updateUI();
    });

    dom.btnToQuad.addEventListener('click', () => {
      const pageFrames = state.frames[state.currentPage];
      if (state.selectedIndex < 0 || state.selectedIndex >= pageFrames.length) return;
      const src = pageFrames[state.selectedIndex];
      if (isQuadTicket(src)) return;

      pageFrames[state.selectedIndex] = normalizeFreeform({
        quad: [
          [Math.round(src.x), Math.round(src.y)],
          [Math.round(src.x + src.w), Math.round(src.y)],
          [Math.round(src.x + src.w), Math.round(src.y + src.h)],
          [Math.round(src.x), Math.round(src.y + src.h)]
        ]
      });
      if (src.wb) pageFrames[state.selectedIndex].wb = src.wb;
      renderOverlay();
      updateUI();
    });

    dom.btnClearPage.addEventListener('click', () => {
      state.frames[state.currentPage] = [];
      state.selectedIndex = -1;
      renderOverlay();
      updateUI();
    });

    // Grille régulière
    dom.btnApplyGrid.addEventListener('click', () => {
      const dims = state.pageDimensions[state.currentPage];
      if (!dims) return;
      const cols = Math.max(1, Math.min(30, parseInt(dom.gridCols.value, 10) || 1));
      const rows = Math.max(1, Math.min(30, parseInt(dom.gridRows.value, 10) || 1));
      dom.gridCols.value = cols;
      dom.gridRows.value = rows;

      const cellW = dims.width / cols;
      const cellH = dims.height / rows;
      const gridFrames = [];

      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          gridFrames.push({
            x: Math.round(c * cellW),
            y: Math.round(r * cellH),
            w: Math.round(cellW),
            h: Math.round(cellH)
          });
        }
      }

      state.frames[state.currentPage] = gridFrames;
      state.selectedIndex = -1;
      renderOverlay();
      updateUI();
    });

    // Algorithme XY-cut pour détection automatique
    dom.gapSlider.addEventListener('input', () => {
      dom.gapValue.textContent = `${dom.gapSlider.value} %`;
    });

    function detectTicketsOnCanvas(sourceCanvas, gapRatio) {
      const width = sourceCanvas.width;
      const height = sourceCanvas.height;
      const ctx = sourceCanvas.getContext('2d', { willReadFrequently: true });
      const imgData = ctx.getImageData(0, 0, width, height).data;

      // Estimation de la couleur de fond à partir des 4 coins (échantillon 4x4 par coin)
      const cornerCoords = [
        [2, 2],
        [Math.max(0, width - 3), 2],
        [2, Math.max(0, height - 3)],
        [Math.max(0, width - 3), Math.max(0, height - 3)]
      ];
      let bgR = 0, bgG = 0, bgB = 0;
      for (const [cx, cy] of cornerCoords) {
        const off = (cy * width + cx) * 4;
        bgR += imgData[off];
        bgG += imgData[off + 1];
        bgB += imgData[off + 2];
      }
      bgR /= 4;
      bgG /= 4;
      bgB /= 4;

      // Grille sous-échantillonnée au pas de 2 px
      const step = 2;
      const gw = Math.floor(width / step);
      const gh = Math.floor(height / step);
      if (gw < 10 || gh < 10) return [];

      const mask = new Uint8Array(gw * gh);
      const threshold = 28;

      for (let gy = 0; gy < gh; gy++) {
        const py = gy * step;
        for (let gx = 0; gx < gw; gx++) {
          const px = gx * step;
          const off = (py * width + px) * 4;
          const a = imgData[off + 3];
          if (a < 20) continue; // Pixel transparent considéré comme fond
          const dr = Math.abs(imgData[off] - bgR);
          const dg = Math.abs(imgData[off + 1] - bgG);
          const db = Math.abs(imgData[off + 2] - bgB);
          if (dr > threshold || dg > threshold || db > threshold) {
            mask[gy * gw + gx] = 1;
          }
        }
      }

      // Espace minimal en unités de grille (basé sur % de la hauteur)
      const minGapUnits = Math.max(2, Math.round((height * gapRatio) / step));
      const leaves = [];

      // Découpe récursive en alternant horizontal et vertical
      function xyCut(x0, y0, x1, y1, preferHorizontal, depth) {
        if (depth > 30) {
          leaves.push({ x0, y0, x1, y1 });
          return;
        }

        // Recadrer d'abord sur le contenu non vide de la sous-région
        let minX = x1, maxX = x0, minY = y1, maxY = y0;
        let hasContent = false;
        for (let y = y0; y < y1; y++) {
          const rowOff = y * gw;
          for (let x = x0; x < x1; x++) {
            if (mask[rowOff + x]) {
              hasContent = true;
              if (x < minX) minX = x;
              if (x > maxX) maxX = x;
              if (y < minY) minY = y;
              if (y > maxY) maxY = y;
            }
          }
        }

        if (!hasContent) return;
        x0 = minX;
        y0 = minY;
        x1 = maxX + 1;
        y1 = maxY + 1;

        if ((x1 - x0) * step < 15 || (y1 - y0) * step < 15) return;

        // Recherche de bandes vides horizontales (lignes vides)
        function findHorizontalSplits() {
          const splits = [];
          let emptyStart = -1;
          for (let y = y0; y < y1; y++) {
            let rowEmpty = true;
            const rowOff = y * gw;
            for (let x = x0; x < x1; x++) {
              if (mask[rowOff + x]) {
                rowEmpty = false;
                break;
              }
            }
            if (rowEmpty) {
              if (emptyStart === -1) emptyStart = y;
            } else {
              if (emptyStart !== -1 && (y - emptyStart) >= minGapUnits) {
                splits.push(Math.floor((emptyStart + y) / 2));
              }
              emptyStart = -1;
            }
          }
          return splits;
        }

        // Recherche de bandes vides verticales (colonnes vides)
        function findVerticalSplits() {
          const splits = [];
          let emptyStart = -1;
          for (let x = x0; x < x1; x++) {
            let colEmpty = true;
            for (let y = y0; y < y1; y++) {
              if (mask[y * gw + x]) {
                colEmpty = false;
                break;
              }
            }
            if (colEmpty) {
              if (emptyStart === -1) emptyStart = x;
            } else {
              if (emptyStart !== -1 && (x - emptyStart) >= minGapUnits) {
                splits.push(Math.floor((emptyStart + x) / 2));
              }
              emptyStart = -1;
            }
          }
          return splits;
        }

        const primarySplits = preferHorizontal ? findHorizontalSplits() : findVerticalSplits();
        if (primarySplits.length > 0) {
          let prev = preferHorizontal ? y0 : x0;
          for (const cut of primarySplits) {
            if (preferHorizontal) {
              xyCut(x0, prev, x1, cut, !preferHorizontal, depth + 1);
            } else {
              xyCut(prev, y0, cut, y1, !preferHorizontal, depth + 1);
            }
            prev = cut;
          }
          if (preferHorizontal) {
            xyCut(x0, prev, x1, y1, !preferHorizontal, depth + 1);
          } else {
            xyCut(prev, y0, x1, y1, !preferHorizontal, depth + 1);
          }
          return;
        }

        const secondarySplits = preferHorizontal ? findVerticalSplits() : findHorizontalSplits();
        if (secondarySplits.length > 0) {
          let prev = !preferHorizontal ? y0 : x0;
          for (const cut of secondarySplits) {
            if (!preferHorizontal) {
              xyCut(x0, prev, x1, cut, preferHorizontal, depth + 1);
            } else {
              xyCut(prev, y0, cut, y1, preferHorizontal, depth + 1);
            }
            prev = cut;
          }
          if (!preferHorizontal) {
            xyCut(x0, prev, x1, y1, preferHorizontal, depth + 1);
          } else {
            xyCut(prev, y0, x1, y1, preferHorizontal, depth + 1);
          }
          return;
        }

        // Aucune coupe possible : bloc feuille
        leaves.push({ x0, y0, x1, y1 });
      }

      xyCut(0, 0, gw, gh, true, 0);

      // Conversion en coordonnées canvas avec 8 px de marge et filtrage < 15 unités
      const margin = 8;
      const results = [];
      for (const b of leaves) {
        const rawW = (b.x1 - b.x0) * step;
        const rawH = (b.y1 - b.y0) * step;
        if (rawW < 15 || rawH < 15) continue;

        const x = Math.max(0, b.x0 * step - margin);
        const y = Math.max(0, b.y0 * step - margin);
        const right = Math.min(width, b.x1 * step + margin);
        const bottom = Math.min(height, b.y1 * step + margin);
        results.push({
          x,
          y,
          w: right - x,
          h: bottom - y
        });
      }

      // Tri par ligne (tolérance verticale d'un demi-ticket) puis par colonne
      results.sort((a, b) => {
        const rowTol = Math.min(a.h, b.h) * 0.5;
        if (Math.abs(a.y - b.y) > rowTol) {
          return a.y - b.y;
        }
        return a.x - b.x;
      });

      return results;
    }

