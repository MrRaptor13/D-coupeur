    // =========================================================================
    // Redressement par surface de Coons multi-points, Upscale bicubique + netteté
    // =========================================================================
    // Longueur approximative d'une chaîne de spline Catmull-Rom
    function approxChainLength(chain, steps = 24) {
      if (chain.length <= 2) {
        return Math.hypot(
          chain[chain.length - 1][0] - chain[0][0],
          chain[chain.length - 1][1] - chain[0][1]
        );
      }
      let len = 0;
      let prev = chain[0];
      for (let i = 1; i <= steps; i++) {
        const cur = evalCatmullRomChain(chain, i / steps);
        len += Math.hypot(cur[0] - prev[0], cur[1] - prev[1]);
        prev = cur;
      }
      return len;
    }

    // Interpolation bicubique de Catmull-Rom (4x4 pixels) pour un échantillonnage haute précision
    function sampleBicubicRGBA(srcData, srcW, srcH, sx, sy, dst, outOff) {
      const xInt = Math.floor(sx);
      const yInt = Math.floor(sy);
      const fx = sx - xInt;
      const fy = sy - yInt;

      const fx2 = fx * fx;
      const fx3 = fx2 * fx;
      const wx0 = -0.5 * fx3 + fx2 - 0.5 * fx;
      const wx1 = 1.5 * fx3 - 2.5 * fx2 + 1.0;
      const wx2 = -1.5 * fx3 + 2.0 * fx2 + 0.5 * fx;
      const wx3 = 0.5 * fx3 - 0.5 * fx2;

      const fy2 = fy * fy;
      const fy3 = fy2 * fy;
      const wy0 = -0.5 * fy3 + fy2 - 0.5 * fy;
      const wy1 = 1.5 * fy3 - 2.5 * fy2 + 1.0;
      const wy2 = -1.5 * fy3 + 2.0 * fy2 + 0.5 * fy;
      const wy3 = 0.5 * fy3 - 0.5 * fy2;

      const wx = [wx0, wx1, wx2, wx3];
      const wy = [wy0, wy1, wy2, wy3];

      let r = 0, g = 0, b = 0;
      for (let m = 0; m < 4; m++) {
        const py = Math.max(0, Math.min(srcH - 1, yInt - 1 + m));
        const rowOff = py * srcW;
        const wYm = wy[m];
        for (let n = 0; n < 4; n++) {
          const px = Math.max(0, Math.min(srcW - 1, xInt - 1 + n));
          const off = (rowOff + px) * 4;
          const w = wYm * wx[n];
          r += srcData[off] * w;
          g += srcData[off + 1] * w;
          b += srcData[off + 2] * w;
        }
      }

      dst[outOff]     = r < 0 ? 0 : r > 255 ? 255 : (r + 0.5) | 0;
      dst[outOff + 1] = g < 0 ? 0 : g > 255 ? 255 : (g + 0.5) | 0;
      dst[outOff + 2] = b < 0 ? 0 : b > 255 ? 255 : (b + 0.5) | 0;
      dst[outOff + 3] = 255;
    }

    // Masque flou (Unsharp Mask) rapide par flou gaussien séparable 3x3 pour renforcer la netteté après upscale
    function applySharpenFilter(imageData, amount = 0.55) {
      const w = imageData.width;
      const h = imageData.height;
      const data = imageData.data;
      if (w < 3 || h < 3 || amount <= 0) return;

      const copy = new Uint8ClampedArray(data);
      const stride = w * 4;

      for (let y = 1; y < h - 1; y++) {
        const row = y * stride;
        const rowUp = (y - 1) * stride;
        const rowDn = (y + 1) * stride;

        for (let x = 1; x < w - 1; x++) {
          const off = row + x * 4;
          for (let c = 0; c < 3; c++) {
            const center = copy[off + c];
            const blur = (
              copy[rowUp + (x - 1) * 4 + c] + 2 * copy[rowUp + x * 4 + c] + copy[rowUp + (x + 1) * 4 + c] +
              2 * copy[off - 4 + c]         + 4 * center                  + 2 * copy[off + 4 + c] +
              copy[rowDn + (x - 1) * 4 + c] + 2 * copy[rowDn + x * 4 + c] + copy[rowDn + (x + 1) * 4 + c]
            ) * 0.0625;
            const sharp = center + amount * (center - blur);
            data[off + c] = sharp < 0 ? 0 : sharp > 255 ? 255 : (sharp + 0.5) | 0;
          }
        }
      }
    }

    // Upscale haute qualité d'un canvas rectangulaire (interpolation bicubique + netteté)
    function upscaleCanvasHQ(srcCanvas, factor) {
      if (factor <= 1.01) return srcCanvas;
      const srcW = srcCanvas.width;
      const srcH = srcCanvas.height;
      const outW = Math.max(1, Math.round(srcW * factor));
      const outH = Math.max(1, Math.round(srcH * factor));

      const srcCtx = srcCanvas.getContext('2d', { willReadFrequently: true });
      const srcData = srcCtx.getImageData(0, 0, srcW, srcH).data;

      const outCanvas = document.createElement('canvas');
      outCanvas.width = outW;
      outCanvas.height = outH;
      const outCtx = outCanvas.getContext('2d');
      const outImgData = outCtx.createImageData(outW, outH);
      const dst = outImgData.data;

      const invFactor = 1 / factor;
      for (let y = 0; y < outH; y++) {
        const sy = (y + 0.5) * invFactor - 0.5;
        let rowOff = y * outW * 4;
        for (let x = 0; x < outW; x++) {
          const sx = (x + 0.5) * invFactor - 0.5;
          sampleBicubicRGBA(srcData, srcW, srcH, sx, sy, dst, rowOff);
          rowOff += 4;
        }
      }

      applySharpenFilter(outImgData, Math.min(0.85, 0.35 + (factor - 1) * 0.25));
      outCtx.putImageData(outImgData, 0, 0);
      return outCanvas;
    }

    // Étirement de contraste : niveaux de gris + normalisation entre percentiles 2 % et 98 %
    function applyReadabilityEnhancement(imageData) {
      const data = imageData.data;
      const pixelCount = data.length / 4;
      if (pixelCount === 0) return;

      const hist = new Uint32Array(256);
      const lum = new Uint8Array(pixelCount);

      for (let i = 0, p = 0; i < data.length; i += 4, p++) {
        const g = Math.round(0.299 * data[i] + 0.587 * data[i + 1] + 0.114 * data[i + 2]);
        lum[p] = g;
        hist[g]++;
      }

      const lowTarget = Math.floor(pixelCount * 0.02);
      const highTarget = Math.floor(pixelCount * 0.98);

      let cum = 0;
      let p2 = 0;
      for (let i = 0; i < 256; i++) {
        cum += hist[i];
        if (cum >= lowTarget) {
          p2 = i;
          break;
        }
      }

      cum = 0;
      let p98 = 255;
      for (let i = 0; i < 256; i++) {
        cum += hist[i];
        if (cum >= highTarget) {
          p98 = i;
          break;
        }
      }

      const range = Math.max(1, p98 - p2);
      for (let i = 0, p = 0; i < data.length; i += 4, p++) {
        const val = Math.max(0, Math.min(255, Math.round(((lum[p] - p2) / range) * 255)));
        data[i] = val;
        data[i + 1] = val;
        data[i + 2] = val;
      }
    }

    // Récupération du canvas source en pleine résolution (échelle 3 pour PDF, natif pour image)
    async function getFullResSourceCanvas(pageIdx) {
      if (state.mode === 'pdf') {
        return getHighResPdfCanvas(pageIdx);
      }
      const item = state.images[pageIdx];
      const canvas = document.createElement('canvas');
      canvas.width = item.width;
      canvas.height = item.height;
      const ctx = canvas.getContext('2d');
      ctx.drawImage(item.img, 0, 0, item.width, item.height);
      return canvas;
    }

    // Redressement d'une forme libre à N points par surface de Coons et upscale bicubique
    async function rectifyQuadToCanvas(pageIdx, quadItem, enhance, upscaleFactor, onRowProgress) {
      const srcCanvas = await getFullResSourceCanvas(pageIdx);
      const srcW = srcCanvas.width;
      const srcH = srcCanvas.height;
      const srcCtx = srcCanvas.getContext('2d', { willReadFrequently: true });
      const srcData = srcCtx.getImageData(0, 0, srcW, srcH).data;

      // Conversion des points vers les coordonnées pleine résolution
      const ratio = state.mode === 'pdf'
        ? (PDF_EXPORT_SCALE / PDF_DISPLAY_SCALE)
        : (1 / state.images[pageIdx].scale);

      const ff = cloneFreeform(quadItem);
      ff.corners = ff.corners.map(([x, y]) => [x * ratio, y * ratio]);
      ff.edges = ff.edges.map(edge => edge.map(([x, y]) => [x * ratio, y * ratio]));

      const [tl, tr, br, bl] = ff.corners;
      const [chainTop, chainRight, chainBottom, chainLeft] = getFreeformChains(ff);

      const topW = approxChainLength(chainTop);
      const botW = approxChainLength(chainBottom);
      const leftH = approxChainLength(chainLeft);
      const rightH = approxChainLength(chainRight);

      const outW = Math.max(10, Math.round(Math.max(topW, botW) * upscaleFactor));
      const outH = Math.max(10, Math.round(Math.max(leftH, rightH) * upscaleFactor));

      const outCanvas = document.createElement('canvas');
      outCanvas.width = outW;
      outCanvas.height = outH;
      const outCtx = outCanvas.getContext('2d');
      const outImgData = outCtx.createImageData(outW, outH);
      const dst = outImgData.data;

      const denomW = Math.max(1, outW - 1);
      const denomH = Math.max(1, outH - 1);
      const useBicubic = upscaleFactor > 1.01;

      // Pré-calcul des tables 1D en u le long des courbes haut et bas
      const topTableX = new Float64Array(outW);
      const topTableY = new Float64Array(outW);
      const botTableX = new Float64Array(outW);
      const botTableY = new Float64Array(outW);
      const uTable = new Float64Array(outW);

      for (let x = 0; x < outW; x++) {
        const u = x / denomW;
        uTable[x] = u;
        const ct = evalCatmullRomChain(chainTop, u);
        const cb = evalCatmullRomChain(chainBottom, u);
        topTableX[x] = ct[0];
        topTableY[x] = ct[1];
        botTableX[x] = cb[0];
        botTableY[x] = cb[1];
      }

      const chunkRows = 64;
      for (let yStart = 0; yStart < outH; yStart += chunkRows) {
        const yEnd = Math.min(outH, yStart + chunkRows);
        for (let y = yStart; y < yEnd; y++) {
          const v = y / denomH;
          const omV = 1 - v;
          const cLeft = evalCatmullRomChain(chainLeft, v);
          const cRight = evalCatmullRomChain(chainRight, v);

          const cornerLeftX = omV * tl[0] + v * bl[0];
          const cornerLeftY = omV * tl[1] + v * bl[1];
          const cornerRightX = omV * tr[0] + v * br[0];
          const cornerRightY = omV * tr[1] + v * br[1];

          let rowOff = y * outW * 4;

          for (let x = 0; x < outW; x++) {
            const u = uTable[x];
            const omU = 1 - u;

            const sx = omV * topTableX[x] + v * botTableX[x]
              + omU * cLeft[0] + u * cRight[0]
              - (omU * cornerLeftX + u * cornerRightX);

            const sy = omV * topTableY[x] + v * botTableY[x]
              + omU * cLeft[1] + u * cRight[1]
              - (omU * cornerLeftY + u * cornerRightY);

            if (sx >= 0 && sx < srcW - 1 && sy >= 0 && sy < srcH - 1) {
              if (useBicubic) {
                sampleBicubicRGBA(srcData, srcW, srcH, sx, sy, dst, rowOff);
              } else {
                const x0 = sx | 0;
                const y0 = sy | 0;
                const fx = sx - x0;
                const fy = sy - y0;
                const w00 = (1 - fx) * (1 - fy);
                const w10 = fx * (1 - fy);
                const w01 = (1 - fx) * fy;
                const w11 = fx * fy;

                const i00 = (y0 * srcW + x0) * 4;
                const i10 = i00 + 4;
                const i01 = i00 + srcW * 4;
                const i11 = i01 + 4;

                dst[rowOff]     = (srcData[i00] * w00 + srcData[i10] * w10 + srcData[i01] * w01 + srcData[i11] * w11) | 0;
                dst[rowOff + 1] = (srcData[i00 + 1] * w00 + srcData[i10 + 1] * w10 + srcData[i01 + 1] * w01 + srcData[i11 + 1] * w11) | 0;
                dst[rowOff + 2] = (srcData[i00 + 2] * w00 + srcData[i10 + 2] * w10 + srcData[i01 + 2] * w01 + srcData[i11 + 2] * w11) | 0;
                dst[rowOff + 3] = 255;
              }
            } else {
              // Fond blanc si hors limites
              dst[rowOff] = 255;
              dst[rowOff + 1] = 255;
              dst[rowOff + 2] = 255;
              dst[rowOff + 3] = 255;
            }
            rowOff += 4;
          }
        }
        if (onRowProgress) {
          onRowProgress(yEnd / outH);
        }
        await new Promise(r => setTimeout(r, 0));
      }

      if (hasWb(quadItem)) applyWbToImageData(outImgData.data, quadItem.wb);

      if (useBicubic) {
        applySharpenFilter(outImgData, Math.min(0.85, 0.35 + (upscaleFactor - 1) * 0.25));
      }

      if (enhance) {
        applyReadabilityEnhancement(outImgData);
      }

      outCtx.putImageData(outImgData, 0, 0);
      return outCanvas;
    }

    // Helpers de rognage image haute résolution (rectangles & formes libres)
    async function getHighResPdfCanvas(pageIdx) {
      if (state.pdfHighResCache.has(pageIdx)) {
        return state.pdfHighResCache.get(pageIdx);
      }
      const page = await state.pdfDoc.getPage(pageIdx + 1);
      const viewport = page.getViewport({ scale: PDF_EXPORT_SCALE });
      const canvas = document.createElement('canvas');
      canvas.width = Math.round(viewport.width);
      canvas.height = Math.round(viewport.height);
      const ctx = canvas.getContext('2d');
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      await page.render({ canvasContext: ctx, viewport }).promise;
      state.pdfHighResCache.set(pageIdx, canvas);
      return canvas;
    }

    async function cropTicketToBlob(pageIdx, frame, format, onProgress) {
      const mimeMap = {
        png: 'image/png',
        jpg: 'image/jpeg',
        webp: 'image/webp'
      };
      const mime = mimeMap[format] || 'image/png';
      const enhance = dom.chkEnhance.checked;
      const upscaleFactor = parseFloat(dom.exportUpscale.value) || 1;

      // Cas forme libre : redressement par surface de Coons + upscale
      if (isQuadTicket(frame)) {
        const rectCanvas = await rectifyQuadToCanvas(pageIdx, frame, enhance, upscaleFactor, onProgress);
        return new Promise((resolve, reject) => {
          rectCanvas.toBlob(
            (blob) => (blob ? resolve(blob) : reject(new Error('Échec de l’encodage de l’image redressée.'))),
            mime,
            0.92
          );
        });
      }

      // Cas cadre rectangulaire
      let outCanvas = document.createElement('canvas');
      const ctx = outCanvas.getContext('2d');

      if (state.mode === 'pdf') {
        const hiCanvas = await getHighResPdfCanvas(pageIdx);
        const ratio = PDF_EXPORT_SCALE / PDF_DISPLAY_SCALE;
        const sx = Math.round(frame.x * ratio);
        const sy = Math.round(frame.y * ratio);
        const sw = Math.max(1, Math.round(frame.w * ratio));
        const sh = Math.max(1, Math.round(frame.h * ratio));

        outCanvas.width = sw;
        outCanvas.height = sh;
        if (format === 'jpg') {
          ctx.fillStyle = '#ffffff';
          ctx.fillRect(0, 0, sw, sh);
        }
        ctx.drawImage(hiCanvas, sx, sy, sw, sh, 0, 0, sw, sh);
      } else {
        const item = state.images[pageIdx];
        const invScale = 1 / item.scale;
        const sx = Math.round(frame.x * invScale);
        const sy = Math.round(frame.y * invScale);
        const sw = Math.max(1, Math.round(frame.w * invScale));
        const sh = Math.max(1, Math.round(frame.h * invScale));

        outCanvas.width = sw;
        outCanvas.height = sh;
        if (format === 'jpg') {
          ctx.fillStyle = '#ffffff';
          ctx.fillRect(0, 0, sw, sh);
        }
        ctx.drawImage(item.img, sx, sy, sw, sh, 0, 0, sw, sh);
      }

      if (hasWb(frame)) {
        const wbCtx = outCanvas.getContext('2d', { willReadFrequently: true });
        const wbData = wbCtx.getImageData(0, 0, outCanvas.width, outCanvas.height);
        applyWbToImageData(wbData.data, frame.wb);
        wbCtx.putImageData(wbData, 0, 0);
      }

      if (upscaleFactor > 1.01) {
        outCanvas = upscaleCanvasHQ(outCanvas, upscaleFactor);
      }

      if (enhance) {
        const outCtx = outCanvas.getContext('2d');
        const imgData = outCtx.getImageData(0, 0, outCanvas.width, outCanvas.height);
        applyReadabilityEnhancement(imgData);
        outCtx.putImageData(imgData, 0, 0);
      }

      return new Promise((resolve, reject) => {
        outCanvas.toBlob(
          (blob) => (blob ? resolve(blob) : reject(new Error('Échec de l’encodage de l’image.'))),
          mime,
          0.92
        );
      });
    }

    // Ajout d'un ticket dans un document pdf-lib
    async function appendTicketToPdfLibDoc(targetPdfDoc, sourcePdfLibDoc, pageIdx, frame, onProgress) {
      const upscaleFactor = parseFloat(dom.exportUpscale.value) || 1;
      const enhance = dom.chkEnhance.checked;

      // Une forme libre est toujours exportée en raster (JPEG intégré dans le PDF)
      if (isQuadTicket(frame)) {
        const rectCanvas = await rectifyQuadToCanvas(pageIdx, frame, enhance, upscaleFactor, onProgress);
        const jpgBlob = await new Promise((resolve, reject) => {
          rectCanvas.toBlob(
            (b) => (b ? resolve(b) : reject(new Error('Échec de l’encodage JPEG.'))),
            'image/jpeg',
            0.92
          );
        });
        const jpgBytes = await jpgBlob.arrayBuffer();
        const jpgImage = await targetPdfDoc.embedJpg(jpgBytes);
        const ptW = (rectCanvas.width / upscaleFactor) * 0.75;
        const ptH = (rectCanvas.height / upscaleFactor) * 0.75;
        const newPage = targetPdfDoc.addPage([ptW, ptH]);
        newPage.drawImage(jpgImage, {
          x: 0,
          y: 0,
          width: ptW,
          height: ptH
        });
        return;
      }

      // Si source PDF et aucun traitement raster (upscale = 1 et pas d'amélioration contraste), découpe vectorielle pure
      if (state.mode === 'pdf' && upscaleFactor <= 1.01 && !enhance && !hasWb(frame)) {
        const srcPage = sourcePdfLibDoc.getPage(pageIdx);
        const cropBox = srcPage.getCropBox() || srcPage.getMediaBox();
        const dispDims = state.pageDimensions[pageIdx] || {
          width: cropBox.width * PDF_DISPLAY_SCALE,
          height: cropBox.height * PDF_DISPLAY_SCALE
        };

        const scaleX = cropBox.width / dispDims.width;
        const scaleY = cropBox.height / dispDims.height;

        // Conversion coordonnées canvas (origine haut-gauche) -> PDF (origine bas-gauche, y inversé)
        const left = cropBox.x + frame.x * scaleX;
        const right = cropBox.x + (frame.x + frame.w) * scaleX;
        const top = cropBox.y + cropBox.height - frame.y * scaleY;
        const bottom = cropBox.y + cropBox.height - (frame.y + frame.h) * scaleY;

        const outW = Math.max(1, right - left);
        const outH = Math.max(1, top - bottom);

        const embedded = await targetPdfDoc.embedPage(srcPage, {
          left,
          bottom,
          right,
          top
        });

        const newPage = targetPdfDoc.addPage([outW, outH]);
        newPage.drawPage(embedded, {
          x: 0,
          y: 0,
          width: outW,
          height: outH
        });
      } else {
        // Source image ou PDF avec upscale/amélioration : rognage en JPEG haute définition
        const jpgBlob = await cropTicketToBlob(pageIdx, frame, 'jpg');
        const jpgBytes = await jpgBlob.arrayBuffer();
        const jpgImage = await targetPdfDoc.embedJpg(jpgBytes);

        let ptW, ptH;
        if (state.mode === 'pdf') {
          const ratio = PDF_EXPORT_SCALE / PDF_DISPLAY_SCALE;
          ptW = Math.max(1, Math.round(frame.w * ratio)) * 0.75;
          ptH = Math.max(1, Math.round(frame.h * ratio)) * 0.75;
        } else {
          const item = state.images[pageIdx];
          ptW = Math.max(1, Math.round(frame.w / item.scale)) * 0.75;
          ptH = Math.max(1, Math.round(frame.h / item.scale)) * 0.75;
        }

        const newPage = targetPdfDoc.addPage([ptW, ptH]);
        newPage.drawImage(jpgImage, {
          x: 0,
          y: 0,
          width: ptW,
          height: ptH
        });
      }
    }

    // Téléchargement universel (capacité runtime Claude si dispo, sinon fallback Blob + <a download>)
    async function triggerDownload(filename, dataBytes, mimeType) {
      // 1. Tentative via la capacité "downloads" du runtime hébergé si disponible
      try {
        if (window.claude && typeof window.claude.use === 'function') {
          const downloadsApi = await window.claude.use('downloads');
          if (downloadsApi && typeof downloadsApi.save === 'function') {
            const res = await downloadsApi.save({ filename, data: dataBytes });
            if (res && res.declined) {
              throw new Error('Téléchargement refusé par l’utilisateur.');
            }
            return;
          }
        }
      } catch (err) {
        if (err.message && err.message.includes('refusé')) {
          throw err;
        }
        // Sinon capacité indisponible : bascule sur le téléchargement classique navigateur
      }

      // 2. Fallback standard navigateur (local ou page web classique)
      const blob = dataBytes instanceof Blob
        ? dataBytes
        : new Blob([dataBytes], { type: mimeType });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      setTimeout(() => URL.revokeObjectURL(url), 5000);
    }

    // Export 1 : ZIP (1 fichier par ticket)
    dom.btnExportZip.addEventListener('click', async () => {
      if (!window.JSZip || !window.PDFLib) {
        setStatus(dom.exportStatus, 'Bibliothèques d’export non chargées.', 'warn');
        return;
      }

      const format = dom.exportFormat.value;
      const ext = format;
      const zip = new JSZip();
      let sourcePdfLibDoc = null;

      dom.btnExportZip.disabled = true;
      dom.btnExportPdf.disabled = true;
      setExportProgress(0);

      try {
        if (state.mode === 'pdf' && format === 'pdf') {
          sourcePdfLibDoc = await PDFLib.PDFDocument.load(state.pdfBytes);
        }

        let globalIndex = 0;
        const totalTickets = state.frames.reduce((s, l) => s + l.length, 0);

        for (let p = 0; p < state.totalPages; p++) {
          const pageFrames = state.frames[p];
          if (!pageFrames || pageFrames.length === 0) continue;

          for (let t = 0; t < pageFrames.length; t++) {
            const ticketIndex = globalIndex;
            globalIndex++;
            setStatus(dom.exportStatus, `Génération du ticket ${globalIndex} / ${totalTickets}…`, 'info');
            setExportProgress(ticketIndex / totalTickets);
            await new Promise(r => setTimeout(r, 5));

            const onSubProgress = (subRatio) => {
              setExportProgress((ticketIndex + subRatio) / totalTickets);
            };

            const numStr = String(globalIndex).padStart(2, '0');
            const suffix = state.mode === 'pdf' ? `p${p + 1}` : `img${p + 1}`;
            const fileName = `${state.baseName}-ticket-${numStr}-${suffix}.${ext}`;

            if (format === 'pdf') {
              const singleDoc = await PDFLib.PDFDocument.create();
              await appendTicketToPdfLibDoc(singleDoc, sourcePdfLibDoc, p, pageFrames[t], onSubProgress);
              const pdfBytes = await singleDoc.save();
              zip.file(fileName, pdfBytes);
            } else {
              const imgBlob = await cropTicketToBlob(p, pageFrames[t], format, onSubProgress);
              zip.file(fileName, imgBlob);
            }
          }
        }

        setExportProgress(1);
        setStatus(dom.exportStatus, 'Compression de l’archive ZIP…', 'info');
        const zipBytes = await zip.generateAsync({ type: 'uint8array' });
        await triggerDownload(`${state.baseName}-tickets.zip`, zipBytes, 'application/zip');
        setStatus(dom.exportStatus, `Archive ZIP prête (${globalIndex} ticket(s)).`, 'ok');
      } catch (err) {
        console.error(err);
        setStatus(dom.exportStatus, 'Erreur lors de l’export ZIP : ' + err.message, 'warn');
      } finally {
        setExportProgress(null);
        updateUI();
      }
    });

    // Export 2 : Un seul PDF (1 ticket par page)
    dom.btnExportPdf.addEventListener('click', async () => {
      if (!window.PDFLib) {
        setStatus(dom.exportStatus, 'Bibliothèque PDF-lib non chargée.', 'warn');
        return;
      }

      dom.btnExportZip.disabled = true;
      dom.btnExportPdf.disabled = true;
      setExportProgress(0);

      try {
        const outPdf = await PDFLib.PDFDocument.create();
        let sourcePdfLibDoc = null;
        if (state.mode === 'pdf') {
          sourcePdfLibDoc = await PDFLib.PDFDocument.load(state.pdfBytes);
        }

        let globalIndex = 0;
        const totalTickets = state.frames.reduce((s, l) => s + l.length, 0);

        for (let p = 0; p < state.totalPages; p++) {
          const pageFrames = state.frames[p];
          if (!pageFrames || pageFrames.length === 0) continue;

          for (let t = 0; t < pageFrames.length; t++) {
            const ticketIndex = globalIndex;
            globalIndex++;
            setStatus(dom.exportStatus, `Ajout au PDF : ticket ${globalIndex} / ${totalTickets}…`, 'info');
            setExportProgress(ticketIndex / totalTickets);
            await new Promise(r => setTimeout(r, 5));

            const onSubProgress = (subRatio) => {
              setExportProgress((ticketIndex + subRatio) / totalTickets);
            };
            await appendTicketToPdfLibDoc(outPdf, sourcePdfLibDoc, p, pageFrames[t], onSubProgress);
          }
        }

        setExportProgress(1);
        setStatus(dom.exportStatus, 'Finalisation du fichier PDF…', 'info');
        const finalPdfBytes = await outPdf.save();
        await triggerDownload(`${state.baseName}-tickets.pdf`, finalPdfBytes, 'application/pdf');
        setStatus(dom.exportStatus, `PDF généré avec succès (${globalIndex} page(s)).`, 'ok');
      } catch (err) {
        console.error(err);
        setStatus(dom.exportStatus, 'Erreur lors de l’export PDF : ' + err.message, 'warn');
      } finally {
        setExportProgress(null);
        updateUI();
      }
    });
  </script>
