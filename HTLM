    // =========================================================================
    // Détection des tickets inclinés / déformés (Morphologie + Enveloppe convexe + Quadrants)
    // =========================================================================
    dom.sensSlider.addEventListener('input', () => {
      dom.sensValue.textContent = dom.sensSlider.value;
