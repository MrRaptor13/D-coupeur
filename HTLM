    // Ordonner 4 points en [haut-gauche, haut-droit, bas-droit, bas-gauche]
    function orderQuadCorners(pts) {
      const cx = pts.reduce((s, p) => s + p[0], 0) / 4;
      const cy = pts.reduce((s, p) => s + p[1], 0) / 4;

      // Tri angulaire dans le sens horaire (dans le repère image y vers le bas)
      const sorted = pts.slice().sort((a, b) => {
        return Math.atan2(a[1] - cy, a[0] - cx) - Math.atan2(b[1] - cy, b[0] - cx);
      });

      // Le coin haut-gauche minimise x + y
      let tlIdx = 0;
      let minSum = Infinity;
      for (let i = 0; i < 4; i++) {
        const s = sorted[i][0] + sorted[i][1];
        if (s < minSum) {
          minSum = s;
          tlIdx = i;
        }
      }

      return [
        sorted[tlIdx],
        sorted[(tlIdx + 1) % 4],
        sorted[(tlIdx + 2) % 4],
        sorted[(tlIdx + 3) % 4]
      ];
    }

    // Enveloppe convexe (Andrew's monotone chain)
    function computeConvexHull(points) {
      if (points.length <= 3) return points.slice();
      const pts = points.slice().sort((a, b) => (a[0] === b[0] ? a[1] - b[1] : a[0] - b[0]));
      const cross = (o, a, b) => (a[0] - o[0]) * (b[1] - o[1]) - (a[1] - o[1]) * (b[0] - o[0]);

      const lower = [];
      for (const p of pts) {
        while (lower.length >= 2 && cross(lower[lower.length - 2], lower[lower.length - 1], p) <= 0) {
          lower.pop();
        }
        lower.push(p);
      }

      const upper = [];
      for (let i = pts.length - 1; i >= 0; i--) {
        const p = pts[i];
        while (upper.length >= 2 && cross(upper[upper.length - 2], upper[upper.length - 1], p) <= 0) {
          upper.pop();
        }
        upper.push(p);
      }

      lower.pop();
      upper.pop();
      return lower.concat(upper);
    }

    // Rectangle d'aire minimale orienté (Rotating Calipers sur enveloppe convexe)
    function minAreaRect(hull) {
      const n = hull.length;
      if (n === 0) return { corners: [[0, 0], [0, 0], [0, 0], [0, 0]], angle: 0, center: [0, 0] };
      if (n < 3) {
        const p0 = hull[0], p1 = hull[n - 1];
        return {
          corners: [p0, p1, p1, p0],
          angle: 0,
          center: [(p0[0] + p1[0]) / 2, (p0[1] + p1[1]) / 2]
        };
      }

      let bestArea = Infinity;
      let bestState = null;

      for (let i = 0; i < n; i++) {
        const p1 = hull[i];
        const p2 = hull[(i + 1) % n];
        const edgeX = p2[0] - p1[0];
        const edgeY = p2[1] - p1[1];
        const len = Math.hypot(edgeX, edgeY);
        if (len < 1e-6) continue;

        const ux = edgeX / len;
        const uy = edgeY / len;
        const vx = -uy;
        const vy = ux;

        let minU = Infinity, maxU = -Infinity;
        let minV = Infinity, maxV = -Infinity;

        for (let j = 0; j < n; j++) {
          const px = hull[j][0];
          const py = hull[j][1];
          const u = px * ux + py * uy;
          const v = px * vx + py * vy;
          if (u < minU) minU = u;
          if (u > maxU) maxU = u;
          if (v < minV) minV = v;
          if (v > maxV) maxV = v;
        }

        const area = (maxU - minU) * (maxV - minV);
        if (area < bestArea) {
          bestArea = area;
          bestState = { ux, uy, vx, vy, minU, maxU, minV, maxV };
        }
      }

      const { ux, uy, vx, vy, minU, maxU, minV, maxV } = bestState;
      const toWorld = (u, v) => [u * ux + v * vx, u * uy + v * vy];
      const corners = [
        toWorld(minU, minV),
        toWorld(maxU, minV),
        toWorld(maxU, maxV),
        toWorld(minU, maxV)
      ];
      const center = toWorld((minU + maxU) / 2, (minV + maxV) / 2);
      return { corners, ux, uy, vx, vy, center };
    }

    // Affinage du quadrilatère aux 4 sommets les plus éloignés du centre dans les 4 quadrants orientés
    function fitQuadFromHull(hull) {
      if (hull.length <= 4) {
        while (hull.length < 4) hull.push(hull[hull.length - 1] || [0, 0]);
        return orderQuadCorners(hull);
      }

      const rectInfo = minAreaRect(hull);
      const [cx, cy] = rectInfo.center;
      const { ux, uy, vx, vy } = rectInfo;

      // 4 quadrants dans le repère orienté (u, v) du rectangle d'aire minimale
      const bestDist = [-1, -1, -1, -1];
      const bestPts = [null, null, null, null];

      for (const p of hull) {
        const dx = p[0] - cx;
        const dy = p[1] - cy;
        const u = dx * ux + dy * uy;
        const v = dx * vx + dy * vy;
        const dist2 = dx * dx + dy * dy;

        let q = 0;
        if (u >= 0 && v < 0) q = 1;
        else if (u >= 0 && v >= 0) q = 2;
        else if (u < 0 && v >= 0) q = 3;

        if (dist2 > bestDist[q]) {
          bestDist[q] = dist2;
          bestPts[q] = p;
        }
      }

      // Fallback sur le coin correspondant du rectangle orienté si un quadrant est vide
      const rectOrdered = orderQuadCorners(rectInfo.corners);
      const quad = bestPts.map((pt, i) => pt || rectOrdered[i]);
      return orderQuadCorners(quad);
    }

    // Fermeture morphologique rapide (dilatation puis érosion avec noyau carré) via table intégrale
    function morphologicalClose(mask, w, h, radius) {
      if (radius < 1) return mask;

      function boxFilterBinary(src, modeDilation) {
        const stride = w + 1;
        const integral = new Int32Array((w + 1) * (h + 1));
        for (let y = 0; y < h; y++) {
          let rowSum = 0;
          const srcOff = y * w;
          const intOff = (y + 1) * stride;
          const prevIntOff = y * stride;
          for (let x = 0; x < w; x++) {
            rowSum += src[srcOff + x];
            integral[intOff + x + 1] = integral[prevIntOff + x + 1] + rowSum;
          }
        }

        const dst = new Uint8Array(w * h);
        for (let y = 0; y < h; y++) {
          const y0 = Math.max(0, y - radius);
          const y1 = Math.min(h - 1, y + radius);
          const areaH = y1 - y0 + 1;
          const dstOff = y * w;
          const r0 = y0 * stride;
          const r1 = (y1 + 1) * stride;

          for (let x = 0; x < w; x++) {
            const x0 = Math.max(0, x - radius);
            const x1 = Math.min(w - 1, x + radius);
            const sum = integral[r1 + x1 + 1] - integral[r0 + x1 + 1] - integral[r1 + x0] + integral[r0 + x0];
            if (modeDilation) {
              if (sum > 0) dst[dstOff + x] = 1;
            } else {
              const total = areaH * (x1 - x0 + 1);
              if (sum === total) dst[dstOff + x] = 1;
            }
          }
        }
        return dst;
      }

      const dilated = boxFilterBinary(mask, true);
      return boxFilterBinary(dilated, false);
    }

    function detectSkewedTicketsOnCanvas(sourceCanvas, threshold) {
      const origW = sourceCanvas.width;
      const origH = sourceCanvas.height;
      const maxOrig = Math.max(origW, origH);
      const scale = maxOrig > 800 ? (800 / maxOrig) : 1;
      const w = Math.max(20, Math.round(origW * scale));
      const h = Math.max(20, Math.round(origH * scale));

      const smallCanvas = document.createElement('canvas');
      smallCanvas.width = w;
      smallCanvas.height = h;
      const ctx = smallCanvas.getContext('2d', { willReadFrequently: true });
      ctx.drawImage(sourceCanvas, 0, 0, w, h);
      const data = ctx.getImageData(0, 0, w, h).data;

      // 1. Estimation de la couleur de fond via médiane des pixels sur le pourtour
      const borderR = [], borderG = [], borderB = [];
      const pushPixel = (x, y) => {
        const off = (y * w + x) * 4;
        if (data[off + 3] < 20) return;
        borderR.push(data[off]);
        borderG.push(data[off + 1]);
        borderB.push(data[off + 2]);
      };

      for (let x = 0; x < w; x++) {
        pushPixel(x, 0);
        pushPixel(x, h - 1);
      }
      for (let y = 1; y < h - 1; y++) {
        pushPixel(0, y);
        pushPixel(w - 1, y);
      }

      const median = (arr) => {
        if (arr.length === 0) return 255;
        arr.sort((a, b) => a - b);
        return arr[Math.floor(arr.length / 2)];
      };
      const bgR = median(borderR);
      const bgG = median(borderG);
      const bgB = median(borderB);

      // Masque binaire différent du fond (distance euclidienne RGB > seuil)
      const mask = new Uint8Array(w * h);
      const threshSq = threshold * threshold;
      for (let i = 0, p = 0; i < data.length; i += 4, p++) {
        if (data[i + 3] < 20) continue;
        const dr = data[i] - bgR;
        const dg = data[i + 1] - bgG;
        const db = data[i + 2] - bgB;
        if (dr * dr + dg * dg + db * db > threshSq) {
          mask[p] = 1;
        }
      }

      // 2. Fermeture morphologique (noyau ≈ 2 % de la largeur => rayon ≈ 1 % de la largeur)
      const radius = Math.max(2, Math.round(w * 0.01));
      const closed = morphologicalClose(mask, w, h, radius);

      // 3. Composantes connexes (BFS)
      const labels = new Int32Array(w * h);
      const queue = new Int32Array(w * h);
      const minArea = w * h * 0.015; // Ignorer < 1,5 % de l'aire de la page
      let components = [];
      let currentLabel = 0;

      for (let y = 0; y < h; y++) {
        for (let x = 0; x < w; x++) {
          const startIdx = y * w + x;
          if (closed[startIdx] === 0 || labels[startIdx] !== 0) continue;

          currentLabel++;
          let head = 0, tail = 0;
          queue[tail++] = startIdx;
          labels[startIdx] = currentLabel;

          let minX = x, maxX = x, minY = y, maxY = y;
          let count = 0;

          while (head < tail) {
            const idx = queue[head++];
            count++;
            const cx = idx % w;
            const cy = (idx - cx) / w;
            if (cx < minX) minX = cx;
            if (cx > maxX) maxX = cx;
            if (cy < minY) minY = cy;
            if (cy > maxY) maxY = cy;

            // 4-voisinage
            if (cx > 0) {
              const n = idx - 1;
              if (closed[n] && labels[n] === 0) { labels[n] = currentLabel; queue[tail++] = n; }
            }
            if (cx < w - 1) {
              const n = idx + 1;
              if (closed[n] && labels[n] === 0) { labels[n] = currentLabel; queue[tail++] = n; }
            }
            if (cy > 0) {
              const n = idx - w;
              if (closed[n] && labels[n] === 0) { labels[n] = currentLabel; queue[tail++] = n; }
            }
            if (cy < h - 1) {
              const n = idx + w;
              if (closed[n] && labels[n] === 0) { labels[n] = currentLabel; queue[tail++] = n; }
            }
          }

          if (count >= minArea) {
            components.push({
              ids: new Set([currentLabel]),
              minX, maxX, minY, maxY
            });
          }
        }
      }

      // Fusionner les composantes dont les boîtes englobantes se chevauchent
      let merged = true;
      while (merged) {
        merged = false;
        for (let i = 0; i < components.length; i++) {
          for (let j = i + 1; j < components.length; j++) {
            const a = components[i];
            const b = components[j];
            const overlaps = !(a.maxX < b.minX || b.maxX < a.minX || a.maxY < b.minY || b.maxY < a.minY);
            if (overlaps) {
              for (const id of b.ids) a.ids.add(id);
              a.minX = Math.min(a.minX, b.minX);
              a.maxX = Math.max(a.maxX, b.maxX);
              a.minY = Math.min(a.minY, b.minY);
              a.maxY = Math.max(a.maxY, b.maxY);
              components.splice(j, 1);
              merged = true;
              break;
            }
          }
          if (merged) break;
        }
      }

      // 4 & 5. Contour -> enveloppe convexe -> quadrilatère -> remise à l'échelle
      const invScale = 1 / scale;
      const results = [];

      for (const comp of components) {
        const contourPts = [];
        for (let y = comp.minY; y <= comp.maxY; y++) {
          const rowOff = y * w;
          for (let x = comp.minX; x <= comp.maxX; x++) {
            const idx = rowOff + x;
            if (!comp.ids.has(labels[idx])) continue;
            const isEdge =
              x === 0 || x === w - 1 || y === 0 || y === h - 1 ||
              !comp.ids.has(labels[idx - 1]) ||
              !comp.ids.has(labels[idx + 1]) ||
              !comp.ids.has(labels[idx - w]) ||
              !comp.ids.has(labels[idx + w]);
            if (isEdge) {
              contourPts.push([x, y]);
            }
          }
        }

        if (contourPts.length < 4) continue;
        const hull = computeConvexHull(contourPts);
        const quadSmall = fitQuadFromHull(hull);
        const quadCanvas = quadSmall.map(([qx, qy]) => [
          Math.max(0, Math.min(origW, Math.round(qx * invScale))),
          Math.max(0, Math.min(origH, Math.round(qy * invScale)))
        ]);

        const minY = Math.min(...quadCanvas.map(p => p[1]));
        const maxY = Math.max(...quadCanvas.map(p => p[1]));
        const minX = Math.min(...quadCanvas.map(p => p[0]));
        results.push({
          freeform: normalizeFreeform({ quad: quadCanvas }),
          _sortY: minY,
          _sortX: minX,
          _sortH: Math.max(10, maxY - minY)
        });
      }

      // Tri par ligne puis par colonne
      results.sort((a, b) => {
        const rowTol = Math.min(a._sortH, b._sortH) * 0.5;
        if (Math.abs(a._sortY - b._sortY) > rowTol) {
          return a._sortY - b._sortY;
        }
        return a._sortX - b._sortX;
      });

      return results.map(r => r.freeform);
    }

